  "views": {
    "list": {
      "arch": "<tree>\n                    <field name=\"name\" modifiers=\"{&quot;required&quot;: true}\"/>\n                    <field name=\"code\" modifiers=\"{&quot;required&quot;: true}\"/>\n                    <field name=\"type\" modifiers=\"{&quot;required&quot;: true}\"/>\n                    <field name=\"country_id\" on_change=\"1\"/>\n                    <field name=\"note\"/>\n                    <field name=\"active\" modifiers=\"{&quot;column_invisible&quot;: true}\"/>\n                </tree>",
      "id": 1465,
      "model": "freight.port"
    },
    "form": {
      "arch": "<form>\n                    <sheet>\n                        <group>\n                            <field name=\"name\" modifiers=\"{&quot;required&quot;: true}\"/>\n                            <field name=\"code\" modifiers=\"{&quot;required&quot;: true}\"/>\n                            <field name=\"vat_name\"/>\n                            <field name=\"type\" modifiers=\"{&quot;required&quot;: true}\"/>\n                            <label for=\"street\" string=\"Address\"/>\n                            <div class=\"o_address_format\">\n                                <field name=\"street\" placeholder=\"Street...\" class=\"o_address_street\"/>\n                                <field name=\"street2\" placeholder=\"Street 2...\" class=\"o_address_street\"/>\n                                <field name=\"city\" placeholder=\"City\" class=\"o_address_city\"/>\n                                <field name=\"state_id\" class=\"o_address_state\" placeholder=\"State\" options=\"{'no_open': True, 'no_quick_create': True}\" context=\"{'default_country_id': country_id}\" on_change=\"1\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"zip\" placeholder=\"ZIP\" class=\"o_address_zip\" on_change=\"1\"/>\n                                <field name=\"country_id\" placeholder=\"Country\" class=\"o_address_country\" options=\"{&quot;no_open&quot;: True, &quot;no_create&quot;: True}\" on_change=\"1\" can_create=\"true\" can_write=\"true\"/>\n                            </div>\n                            <field name=\"note\"/>\n                <field name=\"do_dear\" modifiers=\"{&quot;invisible&quot;: [[&quot;type&quot;, &quot;!=&quot;, &quot;warehouse&quot;]]}\"/>\n                            <field name=\"active\" modifiers=\"{&quot;invisible&quot;: true}\"/>\n                        </group>\n                <field name=\"warehouse_mapping_ids\" widget=\"one2many_list\" nolabel=\"1\">\n                    <tree editable=\"top\">\n                        <field name=\"airline_code\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                        <field name=\"airline_id\" on_change=\"1\" modifiers=\"{&quot;required&quot;: true}\" can_create=\"true\" can_write=\"true\"/>\n                        <field name=\"warehouse_type\"/>\n                        <field name=\"warehouse_id\" modifiers=\"{&quot;required&quot;: true}\" can_create=\"true\" can_write=\"true\"/>\n                    </tree>\n                </field>\n                    </sheet>\n                </form>",
      "id": 1464,
      "model": "freight.port"
    },
    "search": {
      "arch": "<search>\n                    <field name=\"name\"/>\n                    <field name=\"code\"/>\n                    <field name=\"country_id\"/>\n                    <field name=\"note\"/>\n                    <filter name=\"ftr_archived\" string=\"Archived\" domain=\"[('active', '=', False)]\"/>\n                    <separator/>\n                    <filter name=\"ftr_airport\" string=\"Airport\" domain=\"[('type', '=', 'airport')]\"/>\n                    <filter name=\"ftr_seaport\" string=\"Seaport\" domain=\"[('type', '=', 'seaport')]\"/>\n                    <filter name=\"ftr_border_gate\" string=\"Border Gate\" domain=\"[('type', '=', 'border_gate')]\"/>\n                    <filter name=\"ftr_warehouse\" string=\"Warehouse\" domain=\"[('type', '=', 'warehouse')]\"/>\n                </search>",
      "id": 1466,
      "model": "freight.port"
    },
    "kanban": {
      "arch": "<kanban string=\"Freight Port\"><templates><t t-name=\"kanban-box\"><div t-attf-class=\"oe_kanban_card oe_kanban_global_click\"><div class=\"o_kanban_card_content\"><field name=\"code\" modifiers=\"{&quot;required&quot;: true}\"/></div></div></t></templates></kanban>",
