  "views": {
    "list": {
      "arch": "<tree string=\"Statements of Account\">\n                <header>\n                    <button name=\"action_open_payment_request_print\" type=\"object\" string=\"Print Payment Request\"/>\n                </header>\n                <field name=\"name\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                <field name=\"partner_id\" on_change=\"1\" modifiers=\"{&quot;required&quot;: true}\"/>\n                <field name=\"purpose\" modifiers=\"{&quot;required&quot;: true}\"/>\n                <field name=\"date\" on_change=\"1\" modifiers=\"{&quot;required&quot;: true}\"/>\n                <field name=\"date_from\"/>\n                <field name=\"date_to\"/>\n                <field name=\"state\" modifiers=\"{&quot;required&quot;: true}\"/>\n                <field name=\"amount_total\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                <field name=\"payment_state\" widget=\"badge\" decoration-success=\"payment_state == 'paid'\" decoration-warning=\"payment_state == 'partial'\" decoration-danger=\"payment_state == 'not_paid'\" optional=\"show\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                <field name=\"company_id\" optional=\"show\" modifiers=\"{&quot;readonly&quot;: true, &quot;required&quot;: true}\"/>\n                <!--                <field name=\"amount_residual_vnd\"/>-->\n            </tree>",
      "id": 2468,
      "model": "freight.soa"
    },
    "form": {
      "arch": "<form string=\"Statement of Account\" create=\"true\" edit=\"true\">\n                <header>\n                    <button name=\"action_sent\" type=\"object\" string=\"Sent\" modifiers=\"{&quot;invisible&quot;: [[&quot;state&quot;, &quot;not in&quot;, [&quot;draft&quot;]]]}\"/>\n                    <button name=\"action_create_invoices\" type=\"object\" string=\"Create Invoice\" modifiers=\"{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;not in&quot;, [&quot;sent&quot;, &quot;done&quot;]], [&quot;show_invoice_as_bill&quot;, &quot;=&quot;, true]]}\"/>\n                    <button name=\"action_create_invoices\" type=\"object\" string=\"Create Bill\" modifiers=\"{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;not in&quot;, [&quot;sent&quot;, &quot;done&quot;]], [&quot;show_invoice_as_bill&quot;, &quot;=&quot;, false]]}\"/>\n                    <button name=\"action_register_payment\" type=\"object\" string=\"Register Payment\" class=\"btn-primary\" modifiers=\"{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;not in&quot;, [&quot;sent&quot;, &quot;done&quot;]], [&quot;payment_state&quot;, &quot;=&quot;, &quot;paid&quot;]]}\"/>\n                    <button name=\"838\" type=\"action\" string=\"Update Exchange Rate\" modifiers=\"{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;not in&quot;, [&quot;draft&quot;, &quot;sent&quot;]], [&quot;is_foreign_currency&quot;, &quot;=&quot;, false]]}\"/>\n                    <button name=\"action_cancel\" type=\"object\" string=\"Cancel\" modifiers=\"{&quot;invisible&quot;: [[&quot;state&quot;, &quot;not in&quot;, [&quot;draft&quot;, &quot;sent&quot;, &quot;done&quot;]]]}\"/>\n                    <button name=\"action_reset_to_draft\" type=\"object\" string=\"Reset to Draft\" modifiers=\"{&quot;invisible&quot;: [[&quot;state&quot;, &quot;not in&quot;, [&quot;cancel&quot;]]]}\"/>\n                    <button name=\"action_open_payment_request_print\" type=\"object\" string=\"Print Payment Request\" modifiers=\"{&quot;invisible&quot;: [[&quot;type&quot;, &quot;!=&quot;, &quot;credit&quot;]]}\"/>\n                    <button name=\"action_find_candidates\" string=\"Find DC Notes\" type=\"object\" modifiers=\"{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;], [&quot;type&quot;, &quot;!=&quot;, &quot;dc&quot;]]}\"/>\n                    <button name=\"action_find_candidates\" string=\"Find Debit Notes\" type=\"object\" modifiers=\"{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;], [&quot;type&quot;, &quot;!=&quot;, &quot;debit&quot;]]}\"/>\n                    <button name=\"action_find_candidates\" string=\"Find Credit Notes\" type=\"object\" modifiers=\"{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;], [&quot;type&quot;, &quot;!=&quot;, &quot;credit&quot;]]}\"/>\n                    <!-- SOA DC: thêm Credit Note để cấn trừ ròng -->\n                    <button name=\"action_find_credit_candidates\" string=\"Find Credit Notes\" type=\"object\" modifiers=\"{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;], [&quot;type&quot;, &quot;!=&quot;, &quot;dc&quot;]]}\"/>\n                    <field name=\"state\" widget=\"statusbar\" statusbar_visible=\"draft,sent,done,cancel\" modifiers=\"{&quot;required&quot;: true}\"/>\n                </header>\n\n                <sheet>\n                    <div class=\"oe_button_box\" name=\"button_box\">\n                        <field name=\"show_invoice_as_bill\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                        <button class=\"oe_stat_button\" type=\"object\" name=\"action_open_invoices\" icon=\"fa-pencil-square-o\" modifiers=\"{&quot;invisible&quot;: [[&quot;show_invoice_as_bill&quot;, &quot;=&quot;, true]]}\">\n                            <field string=\"Invoices\" name=\"invoice_count\" widget=\"statinfo\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                        </button>\n                        <button class=\"oe_stat_button\" type=\"object\" name=\"action_open_invoices\" icon=\"fa-pencil-square-o\" modifiers=\"{&quot;invisible&quot;: [[&quot;show_invoice_as_bill&quot;, &quot;=&quot;, false]]}\">\n                            <field string=\"Bills\" name=\"bill_count\" widget=\"statinfo\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                        </button>\n                        <button class=\"oe_stat_button\" type=\"object\" name=\"action_open_payments\" icon=\"fa-credit-card\">\n                            <field string=\"Payments\" name=\"payment_count\" widget=\"statinfo\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                        </button>\n                    </div>\n                    <widget name=\"web_ribbon\" title=\"Paid\" modifiers=\"{&quot;invisible&quot;: [[&quot;payment_state&quot;, &quot;!=&quot;, &quot;paid&quot;]]}\"/>\n                    <widget name=\"web_ribbon\" title=\"Partial\" bg_color=\"bg-warning\" modifiers=\"{&quot;invisible&quot;: [[&quot;payment_state&quot;, &quot;!=&quot;, &quot;partial&quot;]]}\"/>\n                    <field name=\"payment_state\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                    <group>\n                        <group>\n                            <field name=\"name\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                            <field name=\"partner_id\" string=\"Customer\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: [[&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;]], &quot;required&quot;: true}\" can_create=\"true\" can_write=\"true\"/>\n                            <field name=\"company_id\" modifiers=\"{&quot;readonly&quot;: true, &quot;required&quot;: true}\"/>\n                            <field name=\"date\" on_change=\"1\" modifiers=\"{&quot;requ