  "views": {
    "list": {
      "arch": "<tree>\n                <header>\n                    <!--                    for inherit-->\n                </header>\n                <field name=\"vendor_id\"/>\n                <field name=\"transport_mode_id\"/>\n                <field name=\"bound\"/>\n                <field name=\"date_from\"/>\n                <field name=\"date_to\"/>\n                <field name=\"remark\"/>\n            </tree>",
      "id": 2867,
      "model": "freight.local.charge"
    },
    "form": {
      "arch": "<form>\n                <sheet>\n                    <group>\n                        <group>\n                            <group>\n\n                                <field name=\"transport_mode_id\" string=\"Service\" on_change=\"1\" can_create=\"false\" can_write=\"false\"/>\n                                <field name=\"transport_mode_code\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                                <field name=\"bound\" string=\"Bound\"/>\n<!--                                <field name=\"local_charge_type\"-->\n<!--                                       attrs=\"{'invisible': [('transport_mode_code', '=', 'air')]}\"/>-->\n                            </group>\n                            <group>\n                                <field name=\"type\" modifiers=\"{&quot;invisible&quot;: true, &quot;required&quot;: true}\"/>\n                                <field name=\"trade_name_id\" string=\"Trade Name\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"carrier_id\" string=\"Carrier\" modifiers=\"{&quot;invisible&quot;: [[&quot;type&quot;, &quot;!=&quot;, &quot;carrier&quot;]]}\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"vendor_id\" string=\"Vender/Coloader\" modifiers=\"{&quot;invisible&quot;: [[&quot;type&quot;, &quot;!=&quot;, &quot;vendor&quot;]]}\" can_create=\"true\" can_write=\"true\"/>\n                            </group>\n                        </group>\n                        <group>\n                            <group>\n                                <field name=\"date_from\"/>\n                            </group>\n                            <group>\n                                <field name=\"date_to\"/>\n                            </group>\n                        </group>\n                    </group>\n                    <group string=\"FCL\" modifiers=\"{&quot;invisible&quot;: [[&quot;transport_mode_code&quot;, &quot;=&quot;, &quot;air&quot;]]}\">\n                        <field name=\"line_ids\" string=\"\">\n                            <tree editable=\"bottom\">\n                                <field name=\"service_id\" string=\"Fare Code\" on_change=\"1\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"fare_name\" string=\"Fare Name\"/>\n                                <field name=\"freight_service_type\" string=\"Fare Type\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                <field name=\"currency_id\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"ctnr_type\" string=\"Curr Type\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"type_20\"/>\n                                <field name=\"type_40\"/>\n                                <field name=\"type_4h\"/>\n                                <field name=\"type_45\"/>\n                                <field name=\"fcl_unit\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"remark\"/>\n                            </tree>\n                        </field>\n                    </group>\n                    <group string=\"LCL\">\n                        <field name=\"other_line_ids\" string=\"\">\n                            <tree editable=\"bottom\">\n                                <field name=\"service_id\" string=\"Fare Code\" on_change=\"1\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"fare_name\" string=\"Fare Name\"/>\n                                <field name=\"freight_service_type\" string=\"Fare Type\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                <field name=\"currency_id\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"unit_id\" modifiers=\"{&quot;column_invisible&quot;: [[&quot;parent.transport_mode_code&quot;, &quot;!=&quot;, &quot;air&quot;]]}\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"unit_price\" string=\"Rate\" modifiers=\"{&quot;column_invisible&quot;: [[&quot;parent.transport_mode_code&quot;, &quot;!=&quot;, &quot;air&quot;]]}\"/>\n                                <field name=\"lcl_rate\" string=\"Rate\" modifiers=\"{&quot;column_invisible&quot;: [[&quot;parent.transport_mode_code&quot;, &quot;=&quot;, &quot;air&quot;]]}\"/>\n                                <field name=\"fcl_unit\" string=\"LCL Unit\" modifiers=\"{&quot;column_invisible&quot;: [[&quot;parent.transport_mode_code&quot;, &quot;=&quot;, &quot;air&quot;]]}\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"remark\"/>\n                            </tree>\n                        </field>\n                    </group>\n                </sheet>\n                <div class=\"oe_chatter\">\n                    <field name=\"message_follower_ids\"/>\n                    <field name=\"activity_ids\"/>\n                    <field name=\"message_ids\"/>\n                </div>\n            </form>",
      "id": 2874,
      "model": "freight.local.charge"
    },
