    "form": {
      "arch": "<form edit=\"1\">\n                    <header>\n                        <button name=\"action_create_bills\" string=\"Create Bill\" type=\"object\" class=\"oe_highlight\" modifiers=\"{&quot;invisible&quot;: [&quot;|&quot;, [&quot;need_bill&quot;, &quot;=&quot;, false], [&quot;can_create_bill&quot;, &quot;=&quot;, false]]}\"/>\n                        <button name=\"action_register_payment\" string=\"Register Payment\" type=\"object\" class=\"oe_highlight\" modifiers=\"{&quot;invisible&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;draft&quot;, &quot;cancel&quot;, &quot;sent&quot;]]]}\"/>\n                        <button name=\"action_approve_credit_note\" string=\"Approve\" type=\"object\" class=\"oe_highlight\" modifiers=\"{&quot;invisible&quot;: [[&quot;can_approve&quot;, &quot;=&quot;, false]]}\"/>\n                <button name=\"action_send_credit_note\" string=\"Send\" type=\"object\" class=\"oe_highlight\" modifiers=\"{&quot;invisible&quot;: [[&quot;can_send&quot;, &quot;=&quot;, false]]}\"/>\n                        <button name=\"action_cancel\" type=\"object\" string=\"Cancel\" modifiers=\"{&quot;invisible&quot;: [&quot;&amp;&quot;, &quot;&amp;&quot;, [&quot;can_cancel_from_draft&quot;, &quot;=&quot;, false], [&quot;can_cancel_from_sent&quot;, &quot;=&quot;, false], [&quot;can_cancel_from_approved&quot;, &quot;=&quot;, false]]}\"/>\n                        <button name=\"action_draft\" type=\"object\" string=\"Set to Draft\" modifiers=\"{&quot;invisible&quot;: [[&quot;can_set_to_draft&quot;, &quot;=&quot;, false]]}\"/>\n                        <button name=\"action_split_credit_note\" type=\"object\" string=\"Split Credit Note\"/>\n                        <button name=\"action_open_payment_request_print\" type=\"object\" string=\"Print Payment Request\"/>\n                        <field name=\"state\" widget=\"statusbar\" statusbar_visible=\"draft,sent,approved,partial_invoiced,billed\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true, &quot;required&quot;: true}\"/>\n                        <field name=\"can_cancel\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                <field name=\"is_com\" on_change=\"1\" modifiers=\"{&quot;invisible&quot;: true}\"/>\n                <field name=\"can_send\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                <field name=\"can_approve\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                <field name=\"can_create_bill\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                <field name=\"can_cancel_from_draft\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                <field name=\"can_cancel_from_sent\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                <field name=\"can_cancel_from_approved\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                <field name=\"can_set_to_draft\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                        <field name=\"need_bill\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                    </header>\n                    <sheet>\n                        <div class=\"oe_button_box\" name=\"button_box\">\n                            <button class=\"oe_stat_button\" type=\"object\" name=\"action_open_bills\" icon=\"fa-pencil-square-o\">\n                                <field string=\"Bills\" name=\"bill_count\" widget=\"statinfo\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                            </button>\n                            <button class=\"oe_stat_button\" type=\"object\" name=\"action_open_payments\" icon=\"fa-credit-card\">\n                                <field string=\"Payments\" name=\"payment_count\" widget=\"statinfo\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                            </button>\n                            <button class=\"oe_stat_button\" type=\"object\" name=\"action_open_soa\" icon=\"fa-file-text-o\" modifiers=\"{&quot;invisible&quot;: [[&quot;soa_id&quot;, &quot;=&quot;, false]]}\">\n                                <field name=\"soa_id\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                                <span class=\"o_stat_text\">SOA</span>\n                            </button>\n                        </div>\n                        <widget name=\"web_ribbon\" title=\"Paid\" modifiers=\"{&quot;invisible&quot;: [[&quot;payment_state&quot;, &quot;!=&quot;, &quot;paid&quot;]]}\"/>\n                        <widget name=\"web_ribbon\" title=\"Partial\" modifiers=\"{&quot;invisible&quot;: [[&quot;payment_state&quot;, &quot;!=&quot;, &quot;partial&quot;]]}\"/>\n                        <field name=\"payment_state\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                        <div class=\"oe_title\">\n                            <h1>\n                                <span class=\"o_form_label\">CD No.</span>\n                                <field name=\"name\" modifiers=\"{&quot;readonly&quot;: true, &quot;required&quot;: true}\"/>\n                            </h1>\n                        </div>\n                        <group>\n                            <group string=\"Party Information\">\n                                <label for=\"partner_id\"/>\n                                <div class=\"o_row\">\n                                    <field name=\"partner_id\" style=\"max-width: 35%\" options=\"{'no_create': True, 'no_create_edit': True}\" context=\"{'form_view_ref': 'sota_freight_advanced.view_partner_form_inherit'}\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true, &quot;required&quot;: true}\"/>\n                <field name=\"is_com\" on_change=\"1\" modifiers=\"{&quot;invisible&quot;: [[&quot;is_com&quot;, &quot;=&quot;, false]], &quot;readonly&quot;: true}\"/>\n                                    <field name=\"partner_display\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                </div>\n                                <label for=\"shipper_id\" string=\"Shipper\"/>\n                                <div class=\"o_row\">\n                                    <field name=\"shipper_id\" style=\"max-width: 35%\" options=\"{'no_create': True, 'no_create_edit': True}\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                    <field name=\"shipper_display\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                </div>\n                                <label for=\"consignee_id\" string=\"Consignee\"/>\n                                <div class=\"o_row\">\n                                    <field name=\"consignee_id\" style=\"max-width: 35%\" options=\"{'no_create': True, 'no_create_edit': True}\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                    <field name=\"consignee_display\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                </div>\n                                <field name=\"pay_for\" can_create=\"true\" can_write=\"true\"/>\n                                <field name=\"pic_id\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                <field name=\"pic_email\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                <field name=\"vendor_invoice_no\"/>\n                                <field name=\"mark_is_paid\" widget=\"boolean_toggle\" on_change=\"1\" modifiers=\"{&quot;invisible&quot;: [[&quot;payment_state&quot;, &quot;not in&quot;, [&quot;partial&quot;]], [&quot;mark_is_paid&quot;, &quot;=&quot;, false]]}\"/>\n                            </group>\n                            <group string=\"Internal Information\">\n                                <field name=\"job_id\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                <field name=\"perf_date\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                <field name=\"master_id\" domain=\"[('job_id', '=', job_id)]\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                <field name=\"house_id\" domain=\"[('job_id', '=', job_id)]\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                <field name=\"reference\"/>\n                                <field name=\"company_id\" modifiers=\"{&quot;required&quot;: true}\" can_create=\"true\" can_write=\"true\"/>\n                            </group>\n                        </group>\n                        <group>\n                            <group string=\"Accounting Information\">\n                                <field name=\"date\" string=\"Billing Date\" modifiers=\"{&quot;required&quot;: true}\"/>\n                                <field name=\"due_date\"/>\n                                <field name=\"payment_request_method\"/>\n                                <field name=\"payment_request_remarks\" placeholder=\"Banking information, payment deadline...\"/>\n<!--                                <field name=\"manual_exchange_rate\"/>-->\n<!--                                <label for=\"exchange_rate\"/>-->\n<!--                                <div class=\"o_row\">-->\n<!--                                    <field name=\"exchange_rate\" readonly=\"0\"/>-->\n<!--                                    <span>VND/USD</span>-->\n<!--                                </div>-->\n<!--                                <field name=\"set_off_amount\"/>-->\n                            </group>\n                        </group>\n                        <notebook>\n                            <page string=\"Service\">\n                                <field name=\"line_ids\" mode=\"tree,kanban\" widget=\"section_and_note_one2many\" on_change=\"1\">\n                                    <tree editable=\"bottom\">\n                                        <control>\n                                            <create name=\"add_product_control\" string=\"Add a product\"/>\n                                            <create name=\"add_section_control\" string=\"Add a section\" context=\"{'default_display_type': 'line_section'}\"/>\n                                            <create name=\"add_note_control\" string=\"Add a note\" context=\"{'default_display_type': 'line_note'}\"/>\n                                        </control>\n                                        <field name=\"sequence\" widget=\"handle\" on_change=\"1\"/>\n                                        <field name=\"selected_for_split\"/>\n                                        <field name=\"vendor_invoice_no\"/>\n                                        <field name=\"transport_mode_id\" string=\"Service\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"product_id\" string=\"Fare\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"fare_type\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"product_name\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"tax_id\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"currency_id\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"exchange_rate\" on_change=\"1\"/>\n                                        <field name=\"fcl_unit\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"qty\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"rate\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"amt\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"local_amount\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"vat_foreign\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"vat\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        <field name=\"remark\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n<!--                                        <field name=\"evidence\" readonly=\"1\"/>-->\n<!--                                        <field name=\"tax_no\" readonly=\"1\"/>-->\n<!--                                        <field name=\"tax_date\" readonly=\"1\"/>-->\n<!--                                        <field name=\"slip_no\" readonly=\"1\"/>-->\n<!--                                        <field name=\"department\" readonly=\"1\"/>-->\n<!--                                        <field name=\"office\" readonly=\"1\"/>-->\n                                    </tree>\n                                </field>\n                                <group name=\"note_group\" class=\"mt-2 mt-md-0\">\n                                    <group>\n                                        <field colspan=\"2\" name=\"remark\" placeholder=\"Remark\"/>\n                                    </group>\n                                    <group class=\"oe_subtotal_footer\" name=\"sale_total\">\n                                        <group string=\"Total\">\n                                            <field name=\"amount_untaxed\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                            <field name=\"amount_taxed\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                            <field name=\"amount_total\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        </group>\n                                        <group string=\"Payment Status\">\n                                            <field name=\"paid_amount\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                            <field name=\"amount_residual\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                        </group>\n                                    </group>\n                                    <div class=\"clearfix\"/>\n                                </group>\n                            </page>\n                        </notebook>\n                    </sheet>\n                    <div class=\"oe_chatter\">\n                        <field name=\"message_follower_ids\"/>\n                        <field name=\"activity_ids\"/>\n                        <field name=\"message_ids\"/>\n                    </div>\n                </form>",
      "id": 2038,
      "model": "freight.credit.note"
    },
    "search": {
      "arch": "<search>\n                <field name=\"name\" string=\"CD No.\"/>\n                <field name=\"partner_id\" string=\"Vendor\"/>\n                <field name=\"job_id\" string=\"Job\"/>\n                <field name=\"remark\" string=\"Remark\" filter_domain=\"['|', ('remark', 'like', self), ('line_ids.remark', 'like', self)]\"/>\n                <field name=\"perf_date\" string=\"Performance Date\"/>\n                <filter name=\"filter_perf_date\" string=\"Performance Date\" date=\"perf_date\"/>\n  <filter string=\"Vendor COM\" name=\"filter_vendor_com\" domain=\"[('line_ids.product_id.is_com_fee','=',True)]\"/>\n  <filter string=\"Customer COM\" name=\"filter_customer_com\" domain=\"[('line_ids.product_id.is_com_customer_fee','=',True)]\"/>\n                <separator/>\n                <filter name=\"vendor_vn\" string=\"Vendor VN\" domain=\"[('partner_id.country_id.code', '=', 'VN')]\"/>\n                <filter name=\"vendor_foreign\" string=\"Vendor Foreign\" domain=\"[('partner_id.country_id.code', '!=', 'VN'), ('partner_id.country_id', '!=', False)]\"/>\n                <separator/>\n                <filter name=\"not_paid\" string=\"Not Paid\" domain=\"[('payment_state', '=', 'not_paid')]\"/>\n                <filter name=\"partial_paid\" string=\"Partially Paid\" domain=\"[('payment_state', '=', 'partial')]\"/>\n                <filter name=\"paid\" string=\"Paid\" domain=\"[('payment_state', '=', 'paid')]\"/>\n                <group expand=\"0\" string=\"Group By\">\n                    <filter name=\"group_by_partner\" string=\"Vendor\" context=\"{'group_by': 'partner_id'}\"/>\n                    <filter name=\"group_by_job\" string=\"Job\" context=\"{'group_by': 'job_id'}\"/>\n                    <filter name=\"group_by_house\" string=\"House B/L\" context=\"{'group_by': 'house_id'}\"/>\n                </group>\n            </search>",
