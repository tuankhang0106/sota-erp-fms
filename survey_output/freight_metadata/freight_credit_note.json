  "views": {
    "list": {
      "arch": "<tree default_order=\"date desc\" create=\"0\">\n                    <field name=\"name\" modifiers=\"{&quot;readonly&quot;: true, &quot;required&quot;: true}\"/>\n                    <field name=\"partner_id\" modifiers=\"{&quot;required&quot;: true}\"/>\n                <field name=\"is_com\" optional=\"show\" on_change=\"1\"/>\n                    <field name=\"job_id\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                <field name=\"customer_id\" optional=\"show\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                <field name=\"pic_id\" optional=\"show\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"house_id\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"master_id\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"date\" modifiers=\"{&quot;required&quot;: true}\"/>\n                <field name=\"etd_job\" optional=\"show\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"due_date\" optional=\"show\"/>\n                    <field name=\"salesman_id\" optional=\"show\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"activity_ids\" widget=\"list_activity\"/>\n                    <field name=\"amount_untaxed\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"amount_total\" sum=\"Total\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"amount_total_foreign\" sum=\"Total (Foreign)\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"paid_amount\" sum=\"Paid Amount\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"amount_residual\" sum=\"Residual Amount\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"company_id\" optional=\"show\" on_change=\"1\" modifiers=\"{&quot;required&quot;: true}\"/>\n                    <field name=\"payment_state\" widget=\"badge\" decoration-danger=\"payment_state == 'not_paid'\" decoration-warning=\"payment_state in ('partial',)\" decoration-success=\"payment_state in ('paid',)\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                    <field name=\"state\" widget=\"badge\" decoration-danger=\"state == 'cancel'\" decoration-warning=\"state == 'partial_invoiced'\" decoration-success=\"state == 'billed'\" modifiers=\"{&quot;readonly&quot;: true, &quot;required&quot;: true}\"/>\n                    <field name=\"currency_id\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: true, &quot;required&quot;: true, &quot;column_invisible&quot;: true}\"/>\n                    <field name=\"company_currency_id\" modifiers=\"{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}\"/>\n                <header>\n                    <button name=\"action_bulk_send_credit_note\" type=\"object\" string=\"Send\" class=\"btn-primary\"/>\n                    <button name=\"action_bulk_cancel_credit_note\" type=\"object\" string=\"Cancel\" class=\"btn-danger\"/>\n                    <button name=\"action_bulk_approve_credit_note\" type=\"object\" string=\"Approve\" class=\"btn-success\"/>\n                    <button name=\"action_bulk_create_bill_credit_note\" type=\"object\" string=\"Create Bill\" class=\"btn-primary\"/>\n                    <button name=\"action_open_payment_request_print\" type=\"object\" string=\"Print Payment Request\"/>\n                </header>\n                </tree>",
      "id": 2037,
