  "views": {
    "list": {
      "arch": "<tree string=\"Groups\">\n                    <field name=\"name\" modifiers=\"{&quot;required&quot;: true}\"/>\n                </tree>",
      "id": 265,
      "model": "mail.channel"
    },
    "form": {
      "arch": "<form string=\"Mail Channel Form\">\n                    <sheet>\n                        <div class=\"oe_button_box\" name=\"button_box\"/>\n                        <field name=\"avatar_128\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true}\"/>\n                        <field name=\"image_128\" widget=\"image\" class=\"oe_avatar\" options=\"{'size': [90, 90], 'preview_image':'avatar_128'}\" on_change=\"1\"/>\n                        <div class=\"oe_title\">\n                            <label for=\"name\" string=\"Group Name\"/>\n                            <h1>\n                                #<field name=\"name\" class=\"oe_inline\" default_focus=\"1\" placeholder=\"e.g. support\" modifiers=\"{&quot;required&quot;: true}\"/>\n                            </h1>\n                        </div>\n                        <group class=\"o_label_nowrap\">\n                            <field name=\"active\" modifiers=\"{&quot;invisible&quot;: true}\"/>\n                            <field name=\"description\" placeholder=\"Topics discussed in this group...\"/>\n                        </group>\n                        <notebook>\n                            <page string=\"Privacy\" name=\"privacy\">\n                                <group class=\"o_label_nowrap\">\n                                    <field name=\"group_public_id\" modifiers=\"{&quot;invisible&quot;: [[&quot;channel_type&quot;, &quot;!=&quot;, &quot;channel&quot;]]}\" can_create=\"true\" can_write=\"true\"/>\n                                    <field name=\"group_ids\" widget=\"many2many_tags\" string=\"Auto Subscribe Groups\" modifiers=\"{&quot;invisible&quot;: [[&quot;channel_type&quot;, &quot;!=&quot;, &quot;channel&quot;]]}\" can_create=\"true\" can_write=\"true\"/>\n                <field name=\"subscription_department_ids\" widget=\"many2many_tags\" string=\"Auto Subscribe Departments\" modifiers=\"{&quot;invisible&quot;: [[&quot;channel_type&quot;, &quot;!=&quot;, &quot;channel&quot;]]}\" can_create=\"true\" can_write=\"true\"/>\n                                </group>\n                            </page>\n                            <page string=\"Members\" name=\"members\">\n                                <field name=\"channel_type\" on_change=\"1\" modifiers=\"{&quot;invisible&quot;: true, &quot;readonly&quot;: true, &quot;required&quot;: true}\"/>\n                                <field name=\"channel_member_ids\" mode=\"tree\" context=\"{'active_test': False}\" modifiers=\"{&quot;readonly&quot;: [[&quot;channel_type&quot;, &quot;=&quot;, &quot;chat&quot;]]}\">\n                                    <tree string=\"Members\" editable=\"bottom\">\n                                        <field name=\"partner_id\" on_change=\"1\" modifiers=\"{&quot;readonly&quot;: [[&quot;id&quot;, &quot;!=&quot;, false]], &quot;required&quot;: true}\" can_create=\"true\" can_write=\"true\"/>\n                                        <field name=\"partner_email\" modifiers=\"{&quot;readonly&quot;: true}\"/>\n                                    </tree>\n                                </field>\n                            </page>\n                            <page string=\"Integrations\" name=\"mail_channel_integrations\" modifiers=\"{&quot;invisible&quot;: true}\"/>\n                        </notebook>\n                    </sheet>\n                </form>",
      "id": 264,
      "model": "mail.channel"
    },
    "search": {
      "arch": "<search string=\"Search Groups\">\n                    <field name=\"name\"/>\n                    <filter string=\"Archived\" name=\"inactive\" domain=\"[('active', '=', False)]\"/>\n                </search>",
      "id": 266,
