<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_history_tree" model="ir.ui.view">
        <field name="name">hr.contract.history.tree</field>
        <field name="model">hr.contract.history</field>
        <field name="arch" type="xml">
            <tree string="Contracts" js_class="hr_contract_history_list" default_order="is_under_contract, date_start desc" edit="false" delete="false" duplicate="false" import="false" create="false">
                <field name="employee_id" widget="many2one_avatar_employee" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="date_hired" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="is_under_contract" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                <field name="name" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="date_start" modifiers="{&quot;readonly&quot;: true}"/>
                <field string="Reference Working Time" name="resource_calendar_id" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="under_contract_state" widget="state_selection" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="structure_type_id" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="currency_id" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                <field name="wage" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'close'" decoration-success="state == 'open'" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="contract_count" modifiers="{&quot;readonly&quot;: true}"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_contract_history_form" model="ir.ui.view">
        <field name="name">hr.contract.history.form</field>
        <field name="model">hr.contract.history</field>
        <field name="arch" type="xml">
            <form string="Contract History" create="false" edit="false" delete="false" duplicate="false" import="false">
                <header>
                    <button name="hr_contract_view_form_new_action" string="Create" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <h1>
                        <div class="d-flex justify-content-start">
                            <div>
                                <field name="display_name" modifiers="{&quot;readonly&quot;: true}"/>
                            </div>
                            <div class="ps-3">
                                <field name="under_contract_state" widget="state_selection" modifiers="{&quot;readonly&quot;: true}"/>
                            </div>
                        </div>
                    </h1>
                    <h2>
                        <field name="employee_id" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                    </h2>
                    <group>
                        <group>
                            <field name="contract_id" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                            <field name="company_country_id" on_change="1" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                            <field name="country_code" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                            <field name="structure_type_id" modifiers="{&quot;readonly&quot;: true}"/>
                            <field name="resource_calendar_id" modifiers="{&quot;readonly&quot;: true}"/>
                            <field name="currency_id" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                            <field name="wage" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                        </group>
                        <group>
                            <field name="department_id" modifiers="{&quot;readonly&quot;: true}"/>
                            <field name="job_id" modifiers="{&quot;readonly&quot;: true}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract History" name="contract_history">
                            <field name="contract_ids" widget="one2many">
                                <tree string="Current Contracts" decoration-primary="state == 'open'" decoration-muted="state == 'close'" decoration-bf="id == parent.contract_id" default_order="date_start desc, state desc" editable="bottom" no_open="1" create="0" delete="0">
                                    <button name="action_open_contract_form" type="object" icon="fa-external-link" title="Open Contract"/>
                                    <field name="id" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                                    <field name="name" string="Contract Name" modifiers="{&quot;required&quot;: true}"/>
                                    <field name="date_start" modifiers="{&quot;required&quot;: true}"/>
                                    <field name="date_end"/>
                                    <field name="resource_calendar_id"/>
                                    <field name="currency_id" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                                    <field name="wage" string="Monthly Wage" modifiers="{&quot;required&quot;: true}"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'close'" decoration-success="state == 'open'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Employee Information" name="contract_others">
                            <group>
                                <field name="date_hired" modifiers="{&quot;readonly&quot;: true}"/>
                                <field name="hr_responsible_id" modifiers="{&quot;readonly&quot;: true}"/>
                                <field name="company_id" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_contract_history_search" model="ir.ui.view">
        <field name="name">hr.contract.history.search</field>
        <field name="model">hr.contract.history</field>
        <field name="arch" type="xml">
            <search string="Search Reference Contracts">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id" operator="child_of"/>
                <field name="resource_calendar_id"/>
                <field name="state"/>
                <field name="is_under_contract"/>
                <filter string="Running Contracts" name="open_contracts" domain="[('state', '=', 'open')]"/>
                <filter string="Contracts to Review" name="contract_to_review" domain="['|', ('state', 'in', ['draft', 'close', 'cancel']), ('is_under_contract', '!=', True)]"/>
                <filter string="No Contracts" name="no_contracts" domain="[('contract_id', '=', False)]"/>
                <filter string="Currently Under Contract" name="currently_under_contract" domain="[('is_under_contract', '=', True)]"/>
                <filter string="Active Employees" name="active_employees" domain="[('active_employee', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Job Position" name="job" domain="[]" context="{'group_by': 'job_id'}"/>
                    <filter string="Status" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Reference Working Time" name="group_by_resource_calendar_id" domain="[]" context="{'group_by': 'resource_calendar_id'}"/>
                    <filter string="Salary Structure Type" name="group_by_structure_type_id" domain="[]" context="{'group_by': 'structure_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_contract_history" model="ir.actions.act_window">
        <field name="name">HR CONTRACT HISTORY</field>
        <field name="res_model">hr.contract.history</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
