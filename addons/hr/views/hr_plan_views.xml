<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_plan_tree" model="ir.ui.view">
        <field name="name">hr.plan.tree</field>
        <field name="model">hr.plan</field>
        <field name="arch" type="xml">
            <tree string="Planning">
                    <field name="name" modifiers="{&quot;required&quot;: true}"/>
                    <field name="steps_count" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="department_id" optional="show"/>
                    <field name="company_id" optional="hide"/>
                    <field name="company_id" modifiers="{&quot;column_invisible&quot;: true}"/>
                </tree>
        </field>
    </record>

    <record id="view_hr_plan_form" model="ir.ui.view">
        <field name="name">hr.plan.form</field>
        <field name="model">hr.plan</field>
        <field name="arch" type="xml">
            <form string="Planning">
                    <field name="company_id" modifiers="{&quot;invisible&quot;: true}" can_create="true" can_write="true"/>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" modifiers="{&quot;invisible&quot;: [[&quot;active&quot;, &quot;=&quot;, true]]}"/>
                        <div class="oe_title">
                            <label for="name" string="Plan Name"/>
                            <h1>
                                <field name="name" placeholder="e.g. Onboarding" modifiers="{&quot;required&quot;: true}"/>
                            </h1>
                        </div>
                        <group>
                            <field name="department_id" can_create="true" can_write="true"/>
                            <field name="company_id" can_create="true" can_write="true"/>
                            <field name="active" modifiers="{&quot;invisible&quot;: true}"/>
                        </group>
                        <notebook>
                            <page string="Activities To Generate">
                                <field name="plan_activity_type_ids" nolabel="1">
                                    <tree>
                                        <field name="company_id" modifiers="{&quot;column_invisible&quot;: true}"/>
                                        <field name="activity_type_id" on_change="1"/>
                                        <field name="summary"/>
                                        <field name="responsible" modifiers="{&quot;required&quot;: true}"/>
                                        <field name="responsible_id" optional="hide" modifiers="{&quot;readonly&quot;: [[&quot;responsible&quot;, &quot;!=&quot;, &quot;other&quot;]]}"/>
                                        <field name="company_id" optional="hide"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
        </field>
    </record>

    <record id="view_hr_plan_search" model="ir.ui.view">
        <field name="name">hr.plan.search</field>
        <field name="model">hr.plan</field>
        <field name="arch" type="xml">
            <search string="Plan">
                    <field name="name"/>
                    <field name="department_id"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
        </field>
    </record>

    <record id="action_hr_plan" model="ir.actions.act_window">
        <field name="name">HR PLAN</field>
        <field name="res_model">hr.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
