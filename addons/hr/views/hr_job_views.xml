<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_tree" model="ir.ui.view">
        <field name="name">hr.job.tree</field>
        <field name="model">hr.job</field>
        <field name="arch" type="xml">
            <tree string="Job" sample="1">
                    <field name="sequence" widget="handle"/>
                    <field name="name" modifiers="{&quot;required&quot;: true}"/>
                    <field name="department_id"/>
                    <field name="no_of_recruitment" on_change="1"/>
                    <field name="no_of_employee" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="expected_employees" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="no_of_hired_employee" optional="hide"/>
                    <field name="message_needaction" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                    <field name="company_id" optional="hide"/>
                    <field name="company_id" modifiers="{&quot;column_invisible&quot;: true}"/>
                </tree>
        </field>
    </record>

    <record id="view_hr_job_form" model="ir.ui.view">
        <field name="name">hr.job.form</field>
        <field name="model">hr.job</field>
        <field name="arch" type="xml">
            <form string="Job">
                    <field name="active" modifiers="{&quot;invisible&quot;: true}"/>
                    <field name="company_id" modifiers="{&quot;invisible&quot;: true}" can_create="true" can_write="true"/>
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Sales Manager" modifiers="{&quot;required&quot;: true}"/></h1>
                        </div>
                        <notebook>
                            <page string="Recruitment" name="recruitment_page">
                                <group>
                                    <group name="recruitment">
                                        <field name="company_id" options="{'no_create': True}" modifiers="{&quot;invisible&quot;: true}" can_create="true" can_write="true"/>
                                        <field name="department_id" can_create="true" can_write="true"/>
                                        <field name="contract_type_id" can_create="true" can_write="true"/>
                                    </group>
                                    <group name="recruitment2">
                                        <label for="no_of_recruitment"/>
                                        <div class="o_row" name="recruitment_target">
                                            <field name="no_of_recruitment" class="o_hr_narrow_field"/>
                                            <span>new Employees</span>
                                        </div>
                                    </group>
                                </group>
                            </page>
                            <page string="Job Summary" name="job_description_page">
                                <field name="description" options="{'collaborative': true}"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" options="{'open_attachments': True}"/>
                        <field name="message_ids"/>
                    </div>
                </form>
        </field>
    </record>

    <record id="view_hr_job_search" model="ir.ui.view">
        <field name="name">hr.job.search</field>
        <field name="model">hr.job</field>
        <field name="arch" type="xml">
            <search string="Jobs">
                    <field name="name" string="Job Position"/>
                    <field name="department_id" operator="child_of"/>
                    <separator/>
                    <filter name="message_needaction" string="Unread Messages" domain="[('message_needaction', '=', True)]"/>
                    <separator/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Department" name="department" domain="[]" context="{'group_by': 'department_id'}"/>
                        <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}"/>
                        <filter string="Employment Type" name="employment_type" domain="[]" context="{'group_by': 'contract_type_id'}"/>
                    </group>
                </search>
        </field>
    </record>

    <record id="action_hr_job" model="ir.actions.act_window">
        <field name="name">HR JOB</field>
        <field name="res_model">hr.job</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
