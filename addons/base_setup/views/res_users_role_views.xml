<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_role_tree" model="ir.ui.view">
        <field name="name">res.users.role.tree</field>
        <field name="model">res.users.role</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" on_change="1" modifiers="{&quot;required&quot;: true}"/>
                <field name="user_ids" modifiers="{&quot;readonly&quot;: true}"/>
            </tree>
        </field>
    </record>

    <record id="view_res_users_role_form" model="ir.ui.view">
        <field name="name">res.users.role.form</field>
        <field name="model">res.users.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                     <div class="oe_button_box" name="button_box">
                        <button name="show_model_access_ids" type="object" class="oe_stat_button" icon="fa-book">
                        <field name="model_access_count" widget="statinfo" string="Access Rights" modifiers="{&quot;readonly&quot;: true}"/>
                        </button>
                        <button name="show_rule_ids" type="object" class="oe_stat_button" icon="fa-server">
                        <field name="rules_count" widget="statinfo" string="Record Rules" modifiers="{&quot;readonly&quot;: true}"/>
                        </button>
                    </div>
                    <group>
                        <field name="name" on_change="1" modifiers="{&quot;required&quot;: true}"/>
                        <field name="group_id" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                    </group>
                    <notebook>
                        <page string="Groups">
                            <field name="implied_ids" nolabel="1" on_change="1" can_create="true" can_write="true"><tree string="Access Groups"><field name="full_name" modifiers="{&quot;readonly&quot;: true}"/></tree></field>
                        </page>
                        <page string="Users">
                            <field name="line_ids" nolabel="1">
                                <tree editable="bottom" decoration-muted="not is_enabled">
                                    <field name="user_id" modifiers="{&quot;required&quot;: true}" can_create="true" can_write="true"/>
                                    <field name="date_from" on_change="1"/>
                                    <field name="date_to" on_change="1"/>
                                    <field name="is_enabled" modifiers="{&quot;readonly&quot;: true}"/>
                                </tree>
                            </field>
                        </page>
                        <page name="page_internal_notes" string="Internal Notes">
                            <field name="comment" on_change="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_users_role_search" model="ir.ui.view">
        <field name="name">res.users.role.search</field>
        <field name="model">res.users.role</field>
        <field name="arch" type="xml">
            <search string="Roles">
                <field name="name"/>
                <field name="user_ids"/>
                <field name="implied_ids"/>
            </search>
        </field>
    </record>

    <record id="action_res_users_role" model="ir.actions.act_window">
        <field name="name">RES USERS ROLE</field>
        <field name="res_model">res.users.role</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
