<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_login_detail_tree" model="ir.ui.view">
        <field name="name">login.detail.tree</field>
        <field name="model">login.detail</field>
        <field name="arch" type="xml">
            <tree>
                    <field name="name"/>
                    <field name="date_time"/>
                    <field name="ip_address"/>
                </tree>
        </field>
    </record>

    <record id="view_login_detail_form" model="ir.ui.view">
        <field name="name">login.detail.form</field>
        <field name="model">login.detail</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_time"/>
                        <field name="ip_address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_login_detail_search" model="ir.ui.view">
        <field name="name">login.detail.search</field>
        <field name="model">login.detail</field>
        <field name="arch" type="xml">
            <search string="Login Details"><field name="name"/></search>
        </field>
    </record>

    <record id="action_login_detail" model="ir.actions.act_window">
        <field name="name">LOGIN DETAIL</field>
        <field name="res_model">login.detail</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
