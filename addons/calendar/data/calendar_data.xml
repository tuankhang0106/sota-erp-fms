<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Alarms -->
        <record id="alarm_notif_15" model="calendar.alarm">
            <field name="name">Thông báo trước 15 phút</field>
            <field name="alarm_type">notification</field>
            <field name="duration">15</field>
            <field name="interval">minutes</field>
        </record>

        <record id="alarm_mail_1" model="calendar.alarm">
            <field name="name">Email trước 1 ngày</field>
            <field name="alarm_type">email</field>
            <field name="duration">1</field>
            <field name="interval">days</field>
        </record>

        <!-- Default Event Types -->
        <record id="categ_meet1" model="calendar.event.type">
            <field name="name">Nội bộ</field>
        </record>

        <record id="categ_meet2" model="calendar.event.type">
            <field name="name">Khách hàng</field>
        </record>
    </data>
</odoo>
