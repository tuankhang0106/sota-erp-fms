<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Calendar View for calendar.event -->
    <record id="view_calendar_event_calendar" model="ir.ui.view">
        <field name="name">calendar.event.calendar</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <calendar js_class="attendee_calendar" string="Meetings" date_start="start" date_stop="stop" date_delay="duration" all_day="allday" event_open_popup="true" event_limit="5" color="partner_ids">
                <field name="attendee_status" modifiers="{&quot;invisible&quot;: true}"/>
                <field name="partner_ids" options="{'block': True, 'icon': 'fa fa-users'}" filters="1" widget="many2manyattendee" write_model="calendar.filters" write_field="partner_id" filter_field="partner_checked" avatar_field="avatar_128"/>
                <field name="videocall_location" widget="url" text="Join Video Call" options="{'icon': 'fa fa-lg fa-video-camera'}" modifiers="{&quot;invisible&quot;: [[&quot;videocall_location&quot;, &quot;=&quot;, false]]}"/>
                <field name="is_highlighted" modifiers="{&quot;invisible&quot;: true}"/>
                <field name="is_organizer_alone" modifiers="{&quot;invisible&quot;: true}"/>
                <field name="display_description" modifiers="{&quot;invisible&quot;: true}"/>
                <field name="location" modifiers="{&quot;invisible&quot;: [[&quot;location&quot;, &quot;=&quot;, false]]}"/>
                <field name="description" modifiers="{&quot;invisible&quot;: [[&quot;display_description&quot;, &quot;=&quot;, false]]}"/>
                <field name="privacy"/>
                <field name="alarm_ids" modifiers="{&quot;invisible&quot;: [[&quot;alarm_ids&quot;, &quot;=&quot;, []]]}"/>
                <field name="categ_ids" options="{'color_field': 'color'}" modifiers="{&quot;invisible&quot;: [[&quot;categ_ids&quot;, &quot;=&quot;, []]]}"/>
                <!-- For recurrence update Dialog -->
                <field name="recurrency" modifiers="{&quot;invisible&quot;: true}"/>
                <field name="recurrence_update" modifiers="{&quot;invisible&quot;: true}"/>
                <field name="partner_id" string="Organizer"/>
            </calendar>
        </field>
    </record>

    <!-- Tree View for calendar.event -->
    <record id="view_calendar_event_tree" model="ir.ui.view">
        <field name="name">calendar.event.tree</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <tree string="Meetings" sample="1" multi_edit="1">
                <header>
                    <button name="action_open_composer" type="object" context="{'composition_mode':'mass_mail'}" string="Send Mail"/>
                <button name="action_send_sms" type="object" string="Send SMS"/>
                </header>
                <field name="name" string="Subject" decoration-bf="1" modifiers="{&quot;readonly&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]], &quot;required&quot;: true}"/>
                <field name="start" string="Start Date" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;required&quot;: true}"/>
                <field name="stop" string="End Date" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;required&quot;: true}"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide" modifiers="{&quot;readonly&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]]}" can_create="true" can_write="true"/>
                <field name="partner_ids" widget="many2many_tags" optional="show" modifiers="{&quot;readonly&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]]}" can_create="true" can_write="true"/>
                <field name="alarm_ids" widget="many2many_tags" optional="hide" modifiers="{&quot;readonly&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]]}" can_create="true" can_write="true"/>
                <field name="categ_ids" widget="many2many_tags" optional="hide" options="{'color_field': 'color'}" modifiers="{&quot;readonly&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]]}" can_create="true" can_write="true"/>
                <field name="recurrency" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="privacy" optional="hide" modifiers="{&quot;readonly&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]], &quot;required&quot;: true}"/>
                <field name="show_as" optional="hide" modifiers="{&quot;readonly&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]], &quot;required&quot;: true}"/>
                <field name="location" optional="show" modifiers="{&quot;readonly&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]]}"/>
                <field name="duration" widget="float_time" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="description" optional="hide" modifiers="{&quot;readonly&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]]}"/>
                <field name="allday" modifiers="{&quot;column_invisible&quot;: true}"/>
                <field name="message_needaction" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
            </tree>
        </field>
    </record>

    <!-- Form View for calendar.event -->
    <record id="view_calendar_event_form" model="ir.ui.view">
        <field name="name">calendar.event.form</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <form string="Meetings" js_class="calendar_form">
                <div class="alert alert-info oe_edit_only" role="status" modifiers="{&quot;invisible&quot;: [[&quot;recurrence_id&quot;, &quot;=&quot;, false]]}">
                    <p>Edit recurring event</p>
                    <field name="recurrence_update" widget="radio"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button string="Document" icon="fa-bars" type="object" name="action_open_calendar_event" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, &quot;|&quot;, [&quot;res_model&quot;, &quot;=&quot;, false], [&quot;res_id&quot;, &quot;=&quot;, false], [&quot;res_id&quot;, &quot;=&quot;, 0]]}"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" modifiers="{&quot;invisible&quot;: [[&quot;active&quot;, &quot;=&quot;, true]]}"/>
                    <field name="res_model" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                    <field name="res_id" modifiers="{&quot;invisible&quot;: true}"/>
                    <field name="attendee_status" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                    <field name="active" modifiers="{&quot;invisible&quot;: true}"/>
                    <div class="oe_title mb-3">
                        <div>
                            <label for="name"/>
                        </div>
                        <h1>
                            <field name="name" placeholder="e.g. Business Lunch" modifiers="{&quot;required&quot;: true}"/>
                        </h1>
                    </div>
                    <div class="d-flex align-items-baseline">
                        <field name="partner_ids" widget="many2manyattendee" placeholder="Select attendees..." context="{'force_email':True}" domain="[('type','!=','private')]" class="oe_inline o_calendar_attendees" can_create="true" can_write="true"/>
                        <div name="send_buttons" class="sm-2">
                            <button name="action_open_composer" help="Send Email to attendees" type="object" string=" EMAIL" icon="fa-envelope"/>
                <button name="action_send_sms" help="Send SMS to attendees" type="object" string="SMS" icon="fa-mobile"/>
                        </div>
                        <button name="action_join_video_call" class="btn-primary" help="Join Video Call" type="object" string="Join Video Call" modifiers="{&quot;invisible&quot;: [[&quot;videocall_location&quot;, &quot;=&quot;, false]]}"/>
                    </div>
                    <div class="alert alert-warning o_form_header mt-2" role="status" modifiers="{&quot;invisible&quot;: [[&quot;invalid_email_partner_ids&quot;, &quot;=&quot;, []]]}">
                        <p><strong>The following attendees have invalid email addresses and won't receive any email notifications:</strong></p>
                        <field name="invalid_email_partner_ids" widget="many2manyattendee" class="oe_inline o_calendar_attendees" modifiers="{&quot;readonly&quot;: true}"/>
                    </div>
                    <notebook>
                        <page name="page_details" string="Meeting Details">
                            <group>
                                <group>

                                    <field name="start_date" string="Starting at" force_save="1" on_change="1" modifiers="{&quot;invisible&quot;: [[&quot;allday&quot;, &quot;=&quot;, false]], &quot;required&quot;: [[&quot;allday&quot;, &quot;=&quot;, true]]}"/>
                                    <field name="stop_date" string="Ending at" force_save="1" on_change="1" modifiers="{&quot;invisible&quot;: [[&quot;allday&quot;, &quot;=&quot;, false]], &quot;required&quot;: [[&quot;allday&quot;, &quot;=&quot;, true]]}"/>

                                    <field name="start" string="Starting at" on_change="1" modifiers="{&quot;invisible&quot;: [[&quot;allday&quot;, &quot;=&quot;, true]], &quot;required&quot;: [[&quot;allday&quot;, &quot;=&quot;, false]]}"/>
                                    <field name="stop" string="Ending At" on_change="1" modifiers="{&quot;invisible&quot;: [[&quot;allday&quot;, &quot;=&quot;, true]], &quot;required&quot;: true}"/>
                                    <label for="duration" modifiers="{&quot;invisible&quot;: [[&quot;allday&quot;, &quot;=&quot;, true]]}"/>
                                    <div modifiers="{&quot;invisible&quot;: [[&quot;allday&quot;, &quot;=&quot;, true]]}">
                                        <field name="duration" widget="float_time" string="Duration" class="oe_inline" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;id&quot;, &quot;!=&quot;, false], [&quot;recurrency&quot;, &quot;=&quot;, true]]}"/>
                                        <span> hours</span>
                                    </div>
                                     <field name="event_tz" modifiers="{&quot;invisible&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, false]]}"/>
                                    <field name="allday" force_save="1" on_change="1"/>
                                    <field name="user_id" widget="many2one_avatar_user" can_create="true" can_write="true"/>
                                </group>
                                <group>
                                    <field name="alarm_ids" widget="many2many_tags" options="{'no_quick_create': True}" can_create="true" can_write="true"/>
                                    <field name="location"/>
                                    <label for="videocall_location"/>
                                    <div col="2" class="o_row">
                                        <field name="videocall_location" class="oe_inline" string="Videocall URL" widget="CopyClipboardChar" force_save="1" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;videocall_source&quot;, &quot;=&quot;, &quot;discuss&quot;]]}"/>
                                        <button name="clear_videocall_location" type="object" class="btn btn-link" context="{'recurrence_update': recurrence_update}" modifiers="{&quot;invisible&quot;: [[&quot;videocall_location&quot;, &quot;=&quot;, false]]}">
                                            <span class="fa fa-times"/><span> Clear meeting</span>
                                        </button>
                                        <button name="set_discuss_videocall_location" type="object" class="btn btn-link" context="{'recurrence_update': recurrence_update}" modifiers="{&quot;invisible&quot;: [[&quot;videocall_location&quot;, &quot;!=&quot;, false]]}">
                                            <span class="fa fa-plus"/><span> Add Odoo meeting</span>
                                        </button>
                                    </div>
                                    <field name="videocall_source" on_change="1" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                                    <field name="access_token" force_save="1" on_change="1" modifiers="{&quot;invisible&quot;: true}"/>
                                    <field name="categ_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" can_create="true" can_write="true"/>
                                </group>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </page>
                        <page name="page_options" string="Options">
                            <group>
                                <div>
                                    <group>
                                        <field name="recurrency" on_change="1"/>
                                    </group>
                                    <div modifiers="{&quot;invisible&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, false]]}">
                                        <group>
                                            <label for="interval"/>
                                            <div class="o_col">
                                                <div class="o_row">
                                                    <field name="interval" class="oe_inline" modifiers="{&quot;required&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]]}"/>
                                                    <field name="rrule_type" modifiers="{&quot;required&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]]}"/>
                                                </div>
                                                <widget name="week_days" modifiers="{&quot;invisible&quot;: [[&quot;rrule_type&quot;, &quot;!=&quot;, &quot;weekly&quot;]]}"/>
                                            </div>
                                            <label string="Until" for="end_type"/>
                                            <div class="o_row">
                                                <field name="end_type" modifiers="{&quot;required&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]]}"/>
                                                <field name="count" modifiers="{&quot;invisible&quot;: [[&quot;end_type&quot;, &quot;!=&quot;, &quot;count&quot;]], &quot;required&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true]]}"/>
                                                <field name="until" modifiers="{&quot;invisible&quot;: [[&quot;end_type&quot;, &quot;!=&quot;, &quot;end_date&quot;]], &quot;required&quot;: [[&quot;end_type&quot;, &quot;=&quot;, &quot;end_date&quot;], [&quot;recurrency&quot;, &quot;=&quot;, true]]}"/>
                                            </div>
                                        </group>
                                        <group modifiers="{&quot;invisible&quot;: [[&quot;rrule_type&quot;, &quot;!=&quot;, &quot;monthly&quot;]]}">
                                            <label string="Day of Month" for="month_by"/>
                                            <div class="o_row">
                                                <field name="month_by"/>
                                                <field name="day" modifiers="{&quot;invisible&quot;: [[&quot;month_by&quot;, &quot;!=&quot;, &quot;date&quot;]], &quot;required&quot;: [[&quot;month_by&quot;, &quot;=&quot;, &quot;date&quot;], [&quot;rrule_type&quot;, &quot;=&quot;, &quot;monthly&quot;]]}"/>
                                                <field name="byday" string="The" modifiers="{&quot;invisible&quot;: [[&quot;month_by&quot;, &quot;!=&quot;, &quot;day&quot;]], &quot;required&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true], [&quot;month_by&quot;, &quot;=&quot;, &quot;day&quot;], [&quot;rrule_type&quot;, &quot;=&quot;, &quot;monthly&quot;]]}"/>
                                                <field name="weekday" nolabel="1" modifiers="{&quot;invisible&quot;: [[&quot;month_by&quot;, &quot;!=&quot;, &quot;day&quot;]], &quot;required&quot;: [[&quot;recurrency&quot;, &quot;=&quot;, true], [&quot;month_by&quot;, &quot;=&quot;, &quot;day&quot;], [&quot;rrule_type&quot;, &quot;=&quot;, &quot;monthly&quot;]]}"/>
                                            </div>
                                        </group>
                                    </div>
                                </div>
                                <group>
                                    <field name="privacy" modifiers="{&quot;required&quot;: true}"/>
                                    <field name="show_as" modifiers="{&quot;required&quot;: true}"/>
                                    <field name="recurrence_id" on_change="1" modifiers="{&quot;invisible&quot;: true}" can_create="true" can_write="true"/>
                                </group>
                            </group>
                        </page>

                        </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View for calendar.event -->
    <record id="view_calendar_event_search" model="ir.ui.view">
        <field name="name">calendar.event.search</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <search string="Search Meetings">
                <field name="name" string="Meeting" filter_domain="[('name', 'ilike', self)]"/>
                <field name="partner_ids"/>
                <field name="user_id"/>
                <field name="location"/>
                <field name="show_as"/>
                <field name="categ_ids"/>
                <field name="description"/>
                <field name="opportunity_id"/>
                <filter string="My Meetings" help="My Meetings" name="mymeetings" domain="[('partner_ids.user_ids', 'in', [uid])]"/>
                <separator/>
                <filter string="Date" name="filter_start_date" date="start"/>
                <separator/>
                <filter string="Busy" name="busy" domain="[('show_as', '=', 'busy')]"/>
                <filter string="Free" name="free" domain="[('show_as', '=', 'free')]"/>
                <separator/>
                <filter string="Public" name="public" domain="[('privacy', '=', 'public')]"/>
                <filter string="Private" name="private" domain="[('privacy', '=', 'private')]"/>
                <filter string="Only Internal Users" name="confidential" domain="[('privacy', '=', 'confidential')]"/>
                <separator/>
                <filter string="Recurrent" name="recurrent" domain="[('recurrency', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Responsible" name="responsible" domain="[]" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action for calendar.event -->
    <record id="action_calendar_event" model="ir.actions.act_window">
        <field name="name">Sự kiện Lịch (Calendar Events)</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">calendar,tree,form</field>
    </record>

</odoo>
