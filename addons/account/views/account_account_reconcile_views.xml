<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_account_reconcile_tree" model="ir.ui.view">
        <field name="name">account.account.reconcile.tree</field>
        <field name="model">account.account.reconcile</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <!-- TODO -->
                <field name="id" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="account_id" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="partner_id" modifiers="{&quot;readonly&quot;: true}"/>
            </tree>
        </field>
    </record>

    <record id="view_account_account_reconcile_form" model="ir.ui.view">
        <field name="name">account.account.reconcile.form</field>
        <field name="model">account.account.reconcile</field>
        <field name="arch" type="xml">
            <form js_class="reconcile_manual" create="0" delete="false">
                <field name="manual_delete" on_change="1" modifiers="{&quot;invisible&quot;: true}"/>
                <field name="manual_reference" on_change="1" modifiers="{&quot;invisible&quot;: true}"/>
                <field name="company_currency_id" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                <field name="foreign_currency_id" modifiers="{&quot;invisible&quot;: true}" can_create="true" can_write="true"/>
                <field name="currency_id" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                <div class="o_form_statusbar o_account_reconcile_oca_statusbar">
                    <div class="o_statusbar_buttons">
                        <button name="reconcile" type="object" string="Reconcile" class="btn btn-primary" modifiers="{&quot;invisible&quot;: [[&quot;is_reconciled&quot;, &quot;=&quot;, true]]}"/>
                        <button name="clean_reconcile" type="object" string="Clean" class="btn btn-secondary" modifiers="{&quot;invisible&quot;: [[&quot;is_reconciled&quot;, &quot;=&quot;, true]]}"/>
                    </div>
                </div>
                <field name="is_reconciled" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                <group>
                    <group>
                    <field name="partner_id" modifiers="{&quot;readonly&quot;: true}"/>
                    </group>
                    <group>
                        <field name="account_id" modifiers="{&quot;readonly&quot;: true}"/>
                    </group>
                </group>
                <field name="reconcile_data_info" nolabel="1" widget="account_reconcile_oca_data" class="w-100"/>
                <notebook>
                    <page name="reconcile_line" string="Reconcile" modifiers="{&quot;invisible&quot;: [[&quot;is_reconciled&quot;, &quot;=&quot;, true]]}">
                        <field name="add_account_move_line_id" widget="account_reconcile_oca_match" domain="[('parent_state', '=', 'posted'), ('amount_residual', '!=', 0), ('account_id', '=', account_id)]" context="{'search_default_partner_id': partner_id, 'tree_view_ref': 'account_reconcile_oca.account_move_line_tree_reconcile_view', 'search_view_ref': 'account_reconcile_oca.account_move_line_search_reconcile_view'}" on_change="1" can_create="true" can_write="true"/>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="view_account_account_reconcile_search" model="ir.ui.view">
        <field name="name">account.account.reconcile.search</field>
        <field name="model">account.account.reconcile</field>
        <field name="arch" type="xml">
            <search create="false" delete="false">
                <field name="account_id"/>
                <field name="partner_id"/>
            </search>
        </field>
    </record>

    <record id="action_account_account_reconcile" model="ir.actions.act_window">
        <field name="name">ACCOUNT ACCOUNT RECONCILE</field>
        <field name="res_model">account.account.reconcile</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
