<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_line_tree" model="ir.ui.view">
        <field name="name">account.move.line.tree</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <tree string="Journal Items" create="false" edit="true" expand="context.get('expand', False)" multi_edit="1" sample="1">
                    <field name="move_id" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;required&quot;: true, &quot;column_invisible&quot;: true}"/>
                    <field name="date" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="company_id" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                    <field name="company_id" optional="hide" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="journal_id" options="{&quot;no_open&quot;:True}" optional="show" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="move_name" string="Journal Entry" widget="open_move_widget" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="account_id" options="{'no_open': True, 'no_create': True}" domain="[('company_id', '=', company_id)]" on_change="1" can_create="true" can_write="true"/>
<field name="ctp_account_ids" widget="many2many_tags" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="partner_id" optional="show" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;move_type&quot;, &quot;!=&quot;, &quot;entry&quot;]]}" can_create="true" can_write="true"/>
                    <field name="ref" optional="hide"/>
                    <field name="product_id" optional="hide" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="name" optional="show"/>
                <field name="ar_lot_ref" optional="hide"/>
                    <field name="tax_ids" widget="many2many_tags" width="0.5" optional="hide" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="amount_currency" optional="show" on_change="1" modifiers="{&quot;invisible&quot;: [[&quot;is_same_currency&quot;, &quot;=&quot;, true]], &quot;readonly&quot;: true}"/>
                    <field name="currency_id" optional="hide" string="Currency" on_change="1" modifiers="{&quot;invisible&quot;: [[&quot;is_same_currency&quot;, &quot;=&quot;, true]], &quot;readonly&quot;: true, &quot;required&quot;: true}" can_create="true" can_write="true"/>
                    <field name="debit" sum="Total Debit" optional="show" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="credit" sum="Total Credit" optional="show" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="tax_tag_ids" string="Tax Grids" domain="[('applicability', '=', 'taxes')]" widget="many2many_tags" width="0.5" optional="hide" on_change="1" can_create="true" can_write="true"/>
                    <field name="discount_date" string="Discount Date" optional="hide"/>
                    <field name="discount_amount_currency" string="Discount Amount" optional="hide"/>
                    <field name="tax_line_id" string="Originator Tax" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="date_maturity" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="balance" sum="Total Balance" optional="hide" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="tax_line_id" string="Tax" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="tax_base_amount" sum="Total Base Amount" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="tax_audit" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="amount_residual" sum="Total Residual" string="Residual" optional="hide" modifiers="{&quot;invisible&quot;: [[&quot;is_account_reconcile&quot;, &quot;=&quot;, false]], &quot;readonly&quot;: true}"/>
                    <field name="amount_residual_currency" sum="Total Residual in Currency" string="Residual in Currency" optional="hide" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;is_same_currency&quot;, &quot;=&quot;, true], [&quot;is_account_reconcile&quot;, &quot;=&quot;, false]], &quot;readonly&quot;: true}"/>
                    <field name="analytic_distribution" widget="analytic_distribution" optional="hide" options="{'product_field': 'product_id', 'account_field': 'account_id', 'force_applicability': 'optional'}"/>
                <field name="analytic_tag_ids" optional="hide" widget="many2many_tags" options="{'color_field': 'color'}" can_create="true" can_write="true"/>

                    <field name="move_type" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                    <field name="parent_state" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
<field name="forward_aml_id" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
<field name="transfer_to_allocation_ids" widget="many2many_tags" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
<field name="transfer_from_allocation_ids" widget="many2many_tags" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
<button name="action_view_account_transfer_allocation" class="oe_stat_button" icon="fa-bars" type="object" string="View Transfers" modifiers="{&quot;invisible&quot;: [[&quot;transfer_to_allocation_ids&quot;, &quot;=&quot;, []], [&quot;transfer_from_allocation_ids&quot;, &quot;=&quot;, []]]}">
</button>
                    <field name="account_type" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                    <field name="statement_line_id" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                    <field name="company_currency_id" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                    <field name="is_same_currency" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                    <field name="is_account_reconcile" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                    <field name="sequence" modifiers="{&quot;column_invisible&quot;: true}"/>
                    <groupby name="partner_id">
                        <button name="edit" type="edit" icon="fa-edit" title="Edit"/>
                    </groupby>
<field name="expense_id" can_create="true" can_write="true"/>
<field name="foreign_currency_id" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
<field name="foreign_amount_untaxed" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
<field name="foreign_amount_total" optional="hide" modifiers="{&quot;readonly&quot;: true}"/>
                </tree>
        </field>
    </record>

    <record id="view_account_move_line_form" model="ir.ui.view">
