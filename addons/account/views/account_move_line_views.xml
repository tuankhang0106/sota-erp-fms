                            <field name="name"/>
                <field name="ar_lot_ref"/>
                            <field name="partner_id" domain="['|', ('parent_id', '=', False), ('is_company', '=', True)]" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                        </group>
                        <notebook colspan="4">
                            <page string="Information" name="information">
                                <group>
                                    <group string="Amount">
                                        <field name="account_id" options="{'no_create': True}" domain="[('company_id', '=', company_id)]" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                                        <field name="debit" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                                        <field name="credit" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                                        <field name="balance" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                                        <field name="quantity" modifiers="{&quot;readonly&quot;: true}"/>
                                    </group>
                                    <group string="Accounting Documents" colspan="2">
                                        <field name="move_id" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;required&quot;: true}"/>
                                        <field name="statement_line_id" modifiers="{&quot;invisible&quot;: [[&quot;statement_line_id&quot;, &quot;=&quot;, false]], &quot;readonly&quot;: true}"/>
                                    </group>
                                    <group string="Dates">
                                        <field name="date" modifiers="{&quot;readonly&quot;: true}"/>
                                        <field name="date_maturity"/>
                                    </group>

                                    <group string="Taxes" modifiers="{&quot;invisible&quot;: [[&quot;tax_line_id&quot;, &quot;=&quot;, false], [&quot;tax_ids&quot;, &quot;=&quot;, []]]}">
                                        <field name="tax_line_id" modifiers="{&quot;invisible&quot;: [[&quot;tax_line_id&quot;, &quot;=&quot;, false]], &quot;readonly&quot;: true}"/>
                                        <field name="tax_ids" widget="many2many_tags" on_change="1" modifiers="{&quot;invisible&quot;: [[&quot;tax_ids&quot;, &quot;=&quot;, []]], &quot;readonly&quot;: true}" can_create="true" can_write="true"/>
                                        <field name="tax_audit" modifiers="{&quot;readonly&quot;: true}"/>
                                    </group>
                                    <group string="Matching" modifiers="{&quot;invisible&quot;: [[&quot;matched_debit_ids&quot;, &quot;=&quot;, []], [&quot;matched_credit_ids&quot;, &quot;=&quot;, []]]}">
                                        <label for="full_reconcile_id"/>
                                        <div>
                                            <field name="full_reconcile_id" modifiers="{&quot;invisible&quot;: [[&quot;full_reconcile_id&quot;, &quot;=&quot;, false]], &quot;readonly&quot;: true}"/>
                                            <field name="matched_debit_ids" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                                            <field name="matched_credit_ids" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                                            <button name="open_reconcile_view" class="oe_link" type="object" string="-&gt; View partially reconciled entries" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;full_reconcile_id&quot;, &quot;!=&quot;, false], &quot;&amp;&quot;, [&quot;matched_debit_ids&quot;, &quot;=&quot;, []], [&quot;matched_credit_ids&quot;, &quot;=&quot;, []]]}">
                                            </button>
                                        </div>
                                    </group>
                                    <group string="Currency">
                                        <field name="currency_id" on_change="1" modifiers="{&quot;invisible&quot;: true, &quot;required&quot;: true}" can_create="true" can_write="true"/>
                                        <field name="display_type" on_change="1" modifiers="{&quot;invisible&quot;: true, &quot;required&quot;: true}"/>
                                        <field name="amount_currency" on_change="1" modifiers="{&quot;readonly&quot;: [&quot;|&quot;, [&quot;display_type&quot;, &quot;!=&quot;, &quot;tax&quot;], [&quot;parent_state&quot;, &quot;!=&quot;, &quot;draft&quot;]]}"/>
                                    </group>
                                    <group string="Product" modifiers="{&quot;invisible&quot;: [[&quot;product_id&quot;, &quot;=&quot;, false]]}">
                                        <field name="product_id" on_change="1" modifiers="{&quot;readonly&quot;: true}"/>
                                    </group>
                                    <group string="States">
                                        <field name="blocked"/>
                                    </group>
                                    <group string="Analytic">
                                        <field name="analytic_distribution" widget="analytic_distribution" modifiers="{&quot;readonly&quot;: true}"/>
                                    </group>
</group>
