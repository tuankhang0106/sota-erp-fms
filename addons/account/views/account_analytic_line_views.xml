<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_line_tree" model="ir.ui.view">
        <field name="name">account.analytic.line.tree</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <tree string="Analytic Items" multi_edit="1">
                <field name="company_id" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;required&quot;: true, &quot;column_invisible&quot;: true}"/>
                <field name="product_uom_category_id" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                <field name="date" optional="show" modifiers="{&quot;required&quot;: true}"/>
                <field name="name" modifiers="{&quot;required&quot;: true}"/>
                <field name="account_id" on_change="1" modifiers="{&quot;required&quot;: true}" can_create="true" can_write="true"/>
                        <field name="ref" optional="hide"/>
                        <field name="general_account_id" optional="hide" can_create="true" can_write="true"/>
                        <field name="move_line_id" widget="line_open_move_widget" optional="hide" on_change="1" can_create="true" can_write="true"/>
                        <field name="product_id" optional="hide" on_change="1" can_create="true" can_write="true"/>
                <field name="plan_id" modifiers="{&quot;readonly&quot;: true}"/>
                <field name="currency_id" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;column_invisible&quot;: true}"/>
                <field name="unit_amount" sum="Quantity" optional="hide" on_change="1"/>
                <field name="product_uom_id" optional="hide" on_change="1" can_create="true" can_write="true"/>
                <field name="partner_id" optional="hide" can_create="true" can_write="true"/>
                <field name="company_id" optional="show" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;required&quot;: true}"/>
                <field name="amount" sum="Total" optional="show" modifiers="{&quot;required&quot;: true}"/>
                <field name="tag_ids" widget="many2many_tags" optional="hide" options="{'color_field': 'color'}" can_create="true" can_write="true"/>
            </tree>
        </field>
    </record>

    <record id="view_account_analytic_line_form" model="ir.ui.view">
        <field name="name">account.analytic.line.form</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <form string="Analytic Item">
            <field name="company_id" on_change="1" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true, &quot;required&quot;: true}"/>
            <sheet>
                <group>
                    <group name="analytic_item" string="Analytic Item">
                        <field name="name" modifiers="{&quot;required&quot;: true}"/>
                        <field name="account_id" modifiers="{&quot;required&quot;: true}" can_create="true" can_write="true"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" can_create="true" can_write="true"/>
                        <field name="date" modifiers="{&quot;required&quot;: true}"/>
                        <field name="company_id" on_change="1" modifiers="{&quot;readonly&quot;: true, &quot;required&quot;: true}"/>
                    </group>
                    <group name="amount" string="Amount">
                        <field name="amount" modifiers="{&quot;required&quot;: true}"/>
                        <field name="ref"/>
                        <field name="partner_id" can_create="true" can_write="true"/>
                        <field name="unit_amount" on_change="1"/>
                        <field name="product_uom_category_id" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                        <field name="product_id" on_change="1" can_create="true" can_write="true"/>
                        <field name="product_uom_id" class="oe_inline" on_change="1" can_create="true" can_write="true"/>
                        <field name="currency_id" on_change="1" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                    </group>
                        <group/> <!-- put Accounting group under Amount group -->
                        <group name="accounting" string="Accounting">
                            <field name="move_line_id" options="{'no_create': True}" widget="line_open_move_widget" on_change="1" can_create="true" can_write="true"/>
                            <field name="general_account_id" modifiers="{&quot;readonly&quot;: [[&quot;move_line_id&quot;, &quot;!=&quot;, false]]}" can_create="true" can_write="true"/>
                        </group>
                </group>
            </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_analytic_line_search" model="ir.ui.view">
        <field name="name">account.analytic.line.search</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <search string="Search Analytic Lines">
                <field name="name"/>
                <field name="date"/>
                        <field name="product_id"/>
                        <field name="partner_id" filter_domain="[('partner_id','child_of',self)]"/>
                <field name="account_id"/>
                <field name="plan_id"/>
                <filter string="Date" name="date" date="date"/>
<separator/>
<filter string="Costs" name="ftr_cost" domain="['|',('move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt')),'&amp;','|',('move_type','=','entry'),('move_id','=',False),('amount', '&lt;=', 0)]"/>
<filter string="Revenues" name="ftr_revenue" domain="['|',('move_type', 'in', ('out_invoice', 'out_refund', 'out_receipt')),'&amp;','|',('move_type','=','entry'),('move_id','=',False),('amount', '&gt;=', 0)]"/>
                <filter string="Analytic Account" name="group_by_analytic_account" context="{'group_by': 'account_id'}"/>
                <filter string="Analytic Plan" name="group_by_analytic_plan" context="{'group_by': 'plan_id'}"/>
                <group string="Group By..." expand="0" name="groupby">
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Category" name="category" context="{'group_by': 'category'}"/>
                </group>
                        <filter string="Financial Account" name="financialaccount" context="{'group_by':'general_account_id'}"/>
                        <filter string="Product" name="product" context="{'group_by':'product_id'}"/>
                        <filter string="Partner" name="partner" context="{'group_by':'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_account_analytic_line" model="ir.actions.act_window">
        <field name="name">ACCOUNT ANALYTIC LINE</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
