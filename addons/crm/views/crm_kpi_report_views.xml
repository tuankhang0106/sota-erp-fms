<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_kpi_report_tree" model="ir.ui.view">
        <field name="name">crm.kpi.report.tree</field>
        <field name="model">crm.kpi.report</field>
        <field name="arch" type="xml">
            <tree string="Crm Kpi Report"><field name="id" modifiers="{&quot;readonly&quot;: true}"/></tree>
        </field>
    </record>

    <record id="view_crm_kpi_report_form" model="ir.ui.view">
        <field name="name">crm.kpi.report.form</field>
        <field name="model">crm.kpi.report</field>
        <field name="arch" type="xml">
            <form string="Report Options">
                <group col="4">
                    <field name="team_id" on_change="1" can_create="true" can_write="true"/>
                    <field name="user_ids" widget="many2many_tags" modifiers="{&quot;required&quot;: true}" can_create="true" can_write="true"/>
                    <field name="activity_type_ids" widget="many2many_tags" modifiers="{&quot;required&quot;: true}" can_create="true" can_write="true"/>
                    <label for="date_from" string="Date"/>
                    <div class="o_row">
                        <field name="date_from" widget="daterange" options="{&quot;related_end_date&quot;: &quot;date_to&quot;}"/>
                        <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                        <field name="date_to" widget="daterange" options="{&quot;related_start_date&quot;: &quot;date_from&quot;}"/>
                    </div>
                </group>
                <group>
                    <field name="company_id" modifiers="{&quot;invisible&quot;: true}" can_create="true" can_write="true"/>
                </group>
                <footer>
                    <button name="get_report_xlsx" string="Print XLSX" type="object" default_focus="1" class="oe_highlight" data-hotkey="q"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_crm_kpi_report_search" model="ir.ui.view">
        <field name="name">crm.kpi.report.search</field>
        <field name="model">crm.kpi.report</field>
        <field name="arch" type="xml">
            <search string="Crm Kpi Report"><field name="id"/></search>
        </field>
    </record>

    <record id="action_crm_kpi_report" model="ir.actions.act_window">
        <field name="name">CRM KPI REPORT</field>
        <field name="res_model">crm.kpi.report</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
