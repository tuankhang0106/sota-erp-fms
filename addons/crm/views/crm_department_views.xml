<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_department_tree" model="ir.ui.view">
        <field name="name">crm.department.tree</field>
        <field name="model">crm.department</field>
        <field name="arch" type="xml">
            <tree string="Sales Department">
                <field name="name" modifiers="{&quot;required&quot;: true}"/>
                <field name="user_id"/>
                <field name="team_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_department_form" model="ir.ui.view">
        <field name="name">crm.department.form</field>
        <field name="model">crm.department</field>
        <field name="arch" type="xml">
            <form string="Sales Department">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Sales Department"/>
                        <h1>
                            <field class="text-break" name="name" modifiers="{&quot;required&quot;: true}"/>
                        </h1>
                        <div name="options_active"/>
                    </div>
                    <group string="Department Details">
                        <field name="user_id" can_create="true" can_write="true"/>
                    </group>
                    <notebook>
                        <page string="Teams" name="teams">
                            <field name="team_ids" class="w-100" widget="many2many">
                                <kanban>
                                    <field name="id" modifiers="{&quot;readonly&quot;: true}"/>
                                    <field name="name" modifiers="{&quot;required&quot;: true}"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_card oe_kanban_global_click">
                                                <div class="o_kanban_card_content d-flex">
                                                    <div>
                                                        <img t-att-src="kanban_image('res.users', 'avatar_128', record.user_id.raw_value)" class="o_kanban_image o_image_64_cover" alt="Avatar"/>
                                                    </div>
                                                    <div class="oe_kanban_details d-flex flex-column ms-3">
                                                        <strong class="o_kanban_record_title oe_partner_heading"><field name="name" modifiers="{&quot;required&quot;: true}"/></strong>
                                                        <div class="d-flex align-items-baseline text-break">
                                                            <field name="user_id"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_department_search" model="ir.ui.view">
        <field name="name">crm.department.search</field>
        <field name="model">crm.department</field>
        <field name="arch" type="xml">
            <search string="Sales Department"><field name="name"/></search>
        </field>
    </record>

    <record id="action_crm_department" model="ir.actions.act_window">
        <field name="name">CRM DEPARTMENT</field>
        <field name="res_model">crm.department</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
