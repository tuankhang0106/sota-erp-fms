<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mailing_mailing_tree" model="ir.ui.view">
        <field name="name">mailing.mailing.tree</field>
        <field name="model">mailing.mailing</field>
        <field name="arch" type="xml">
            <tree string="Mailings" sample="1" class="o_mass_mailing_mailing_tree">
                    <field name="calendar_date" string="Date" widget="datetime" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="subject" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]], &quot;required&quot;: true}"/>
                    <field name="mailing_model_id" string="Recipients" optional="hide" modifiers="{&quot;required&quot;: true}"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                    <field name="ab_testing_enabled" string="A/B Test"/>
                    <field name="campaign_id" string="Campaign" optional="hide"/>
                    <field name="sent" sum="Total" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="received_ratio" class="d-flex align-items-center ps-0 ps-lg-5" widget="progressbar" string="Delivered (%)" avg="Average" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="opened_ratio" class="d-flex align-items-center ps-0 ps-lg-5" widget="progressbar" string="Opened (%)" avg="Average" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="bounced_ratio" string="Bounced (%)" optional="hide" avg="Average" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="clicks_ratio" string="Clicked (%)" avg="Average" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="replied_ratio" string="Replied (%)" avg="Average" modifiers="{&quot;readonly&quot;: true}"/>
                    <field name="state" decoration-info="state in ['draft', 'in_queue']" decoration-success="state == 'sending' or state == 'done'" widget="badge" on_change="1" modifiers="{&quot;required&quot;: true}"/>
                </tree>
        </field>
    </record>

    <record id="view_mailing_mailing_form" model="ir.ui.view">
        <field name="name">mailing.mailing.form</field>
        <field name="model">mailing.mailing</field>
        <field name="arch" type="xml">
            <form string="Mailing" class="o_mass_mailing_mailing_form">
                    <header style="min-height:31px;">
                        <button name="action_launch" type="object" class="oe_highlight" string="Send" data-hotkey="v" confirm="This will send the email to all recipients. Do you still want to proceed ?" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;in_queue&quot;, &quot;sending&quot;, &quot;done&quot;]]]}"/>
                        <button name="action_schedule" type="object" class="btn-secondary" string="Schedule" data-hotkey="x" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;in_queue&quot;, &quot;sending&quot;, &quot;done&quot;]]]}"/>
                        <button name="action_duplicate" type="object" class="btn-secondary" string="Duplicate" data-hotkey="d" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;!=&quot;, &quot;done&quot;]]}"/>
                        <button name="action_test" type="object" class="btn-secondary" string="Test" data-hotkey="k"/>
                        <button name="action_cancel" type="object" class="btn-secondary" string="Cancel" data-hotkey="z" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;!=&quot;, &quot;in_queue&quot;]]}"/>
                        <button name="action_retry_failed" type="object" class="oe_highlight" string="Retry" data-hotkey="y" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;!=&quot;, &quot;done&quot;], [&quot;failed&quot;, &quot;=&quot;, 0]]}"/>

                        <field name="state" widget="statusbar" modifiers="{&quot;readonly&quot;: true, &quot;required&quot;: true}"/>
                    </header>
                    <div class="alert alert-info text-center" role="alert" modifiers="{&quot;invisible&quot;: [&quot;&amp;&quot;, &quot;&amp;&quot;, &quot;&amp;&quot;, &quot;&amp;&quot;, &quot;&amp;&quot;, [&quot;state&quot;, &quot;!=&quot;, &quot;in_queue&quot;], [&quot;sent&quot;, &quot;=&quot;, 0], [&quot;canceled&quot;, &quot;=&quot;, 0], [&quot;scheduled&quot;, &quot;=&quot;, 0], [&quot;failed&quot;, &quot;=&quot;, 0], [&quot;warning_message&quot;, &quot;=&quot;, false]]}">
                        <div class="o_mails_canceled" modifiers="{&quot;invisible&quot;: [[&quot;canceled&quot;, &quot;=&quot;, 0]]}">
                            <button class="btn-link py-0" name="action_view_traces_canceled" type="object">
                                <strong>
                                    <field name="canceled" class="oe_inline me-2" modifiers="{&quot;readonly&quot;: true}"/>
                                    <span name="canceled_text">emails have been canceled and will not be sent.</span>
                                </strong>
                            </button>
                        </div>
                        <div class="o_mails_scheduled" modifiers="{&quot;invisible&quot;: [[&quot;scheduled&quot;, &quot;=&quot;, 0]]}">
                            <button class="btn-link py-0" name="action_view_traces_scheduled" type="object">
                                <strong>
                                    <field name="scheduled" class="oe_inline me-2" modifiers="{&quot;readonly&quot;: true}"/>
                                    <span name="scheduled_text">emails are in queue and will be sent soon.</span>
                                </strong>
                            </button>
                        </div>
                        <div class="o_mails_sent" modifiers="{&quot;invisible&quot;: [&quot;&amp;&quot;, [&quot;sent&quot;, &quot;=&quot;, 0], [&quot;state&quot;, &quot;in&quot;, [&quot;draft&quot;, &quot;test&quot;, &quot;in_queue&quot;]]]}">
                            <button class="btn-link py-0" name="action_view_traces_sent" type="object">
                                <strong>
                                    <field name="sent" class="oe_inline me-2" modifiers="{&quot;readonly&quot;: true}"/>
                                    <span name="sent">emails have been sent.</span>
                                </strong>
                            </button>
                        </div>
                        <div class="o_mails_failed" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;!=&quot;, &quot;done&quot;], [&quot;failed&quot;, &quot;=&quot;, 0]]}">
                            <button class="btn-link py-0" name="action_view_traces_failed" type="object">
                                <strong>
                                    <field name="failed" class="oe_inline me-2" modifiers="{&quot;readonly&quot;: true}"/>
                                    <span name="failed_text">emails could not be sent.</span>
                                </strong>
                            </button>
                        </div>
                        <div class="o_mails_in_queue" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;!=&quot;, &quot;in_queue&quot;]]}">
                            <strong>
                                <span name="next_departure_text">This mailing is scheduled for </span>
                                <field name="next_departure" class="oe_inline" modifiers="{&quot;readonly&quot;: true}"/>.
                            </strong>
                        </div>
                        <div modifiers="{&quot;invisible&quot;: [[&quot;warning_message&quot;, &quot;=&quot;, false]]}">
                            <strong><field name="warning_message" modifiers="{&quot;readonly&quot;: true}"/></strong>
                        </div>
                    </div>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                <button name="action_redirect_to_leads_and_opportunities" type="object" icon="fa-star" class="oe_stat_button" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;=&quot;, &quot;draft&quot;]]}">
                    <div class="o_field_widget o_stat_info">
                        <field name="use_leads" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                        <span class="o_stat_value"><field nolabel="1" name="crm_lead_count" modifiers="{&quot;readonly&quot;: true}"/></span>
                        <span class="o_stat_text" modifiers="{&quot;invisible&quot;: [[&quot;use_leads&quot;, &quot;=&quot;, false]]}">Leads</span>
                        <span class="o_stat_text" modifiers="{&quot;invisible&quot;: [[&quot;use_leads&quot;, &quot;=&quot;, true]]}">Opportunities</span>
                    </div>
                </button>
                            <button name="action_view_delivered" id="button_view_delivered" type="object" context="{'search_default_filter_delivered': True}" class="oe_stat_button" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;draft&quot;, &quot;test&quot;]]]}">
                                <field name="received_ratio" string="Received" widget="percentpie" modifiers="{&quot;readonly&quot;: true}"/>
                            </button>
                            <button name="action_view_opened" type="object" context="{'search_default_filter_opened': True}" class="oe_stat_button" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;draft&quot;, &quot;test&quot;]]]}">
                                <field name="opened_ratio" string="Opened" widget="percentpie" modifiers="{&quot;readonly&quot;: true}"/>
                            </button>
                            <button name="action_view_clicked" type="object" context="{'search_default_filter_clicked': True}" class="oe_stat_button" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;draft&quot;, &quot;test&quot;]]]}">
                                <field name="clicks_ratio" string="Clicked" widget="percentpie" modifiers="{&quot;readonly&quot;: true}"/>
                            </button>
                            <button name="action_view_replied" type="object" context="{'search_default_filter_replied': True}" class="oe_stat_button" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;draft&quot;, &quot;test&quot;]]]}">
                                <field name="replied_ratio" string="Replied" widget="percentpie" modifiers="{&quot;readonly&quot;: true}"/>
                            </button>
                            <button name="action_view_bounced" type="object" context="{'search_default_filter_bounced': True}" class="oe_stat_button" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;draft&quot;, &quot;test&quot;]]]}">
                                <field name="bounced_ratio" string="Bounced" widget="percentpie" modifiers="{&quot;readonly&quot;: true}"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" modifiers="{&quot;invisible&quot;: [[&quot;active&quot;, &quot;=&quot;, true]]}"/>
                        <group class="o_mass_mailing_mailing_group">
                            <field name="active" modifiers="{&quot;invisible&quot;: true}"/>
                            <field name="create_uid" on_change="1" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                            <field name="mailing_type" widget="radio" options="{'horizontal': true}" force_save="1" on_change="1" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: [[&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;]], &quot;required&quot;: true}"/>
                            <label for="subject">Subject</label>
                            <div class="o_mass_mailing_subject d-flex flex-row align-items-baseline">
                                <field class="text-break" name="subject" string="Subject" options="{'dynamic_placeholder': true}" widget="char_emojis" placeholder="e.g. New Sale on all T-shirts" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]], &quot;required&quot;: true}"/>
                                <field name="favorite" modifiers="{&quot;invisible&quot;: true}"/>
                                <button type="object" name="action_set_favorite" class="o_mass_mailing_favorite p-0" icon="fa-star-o" title="Add to Templates" modifiers="{&quot;invisible&quot;: [[&quot;favorite&quot;, &quot;=&quot;, true]]}"/>
                                <button type="object" name="action_remove_favorite" class="o_mass_mailing_favorite p-0" icon="fa-star" title="Remove from Templates" modifiers="{&quot;invisible&quot;: [[&quot;favorite&quot;, &quot;=&quot;, false]]}"/>
                            </div>
                            <label for="mailing_model_id" string="Recipients"/>
                            <div name="mailing_model_id_container">
                                <div class="d-flex align-items-baseline flex-wrap">
                                    <div class="me-5">
                                        <field name="mailing_model_id" options="{'no_open': True, 'no_create': True}" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]], &quot;required&quot;: true}" can_create="true" can_write="true"/>
                                    </div>
                                    <div class="o_mass_mailing_contact_list_ids pt-1 pt-sm-0" modifiers="{&quot;invisible&quot;: [[&quot;mailing_model_name&quot;, &quot;!=&quot;, &quot;mailing.list&quot;]]}">
                                        <label for="contact_list_ids" string="Select mailing lists:" class="oe_edit_only pe-2"/>
                                        <div class="d-inline-flex flex-row align-items-center">
                                            <field name="contact_list_ids" widget="many2many_tags" placeholder="Select mailing lists..." class="oe_inline mb-0" context="{'form_view_ref': 'mass_mailing.mailing_list_view_form_simplified'}" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]], &quot;required&quot;: [[&quot;mailing_model_name&quot;, &quot;=&quot;, &quot;mailing.list&quot;]]}" can_create="true" can_write="true"/>
                                            <button icon="fa-user-plus" type="object" class="btn btn-secondary py-0 px-1 ms-1" name="action_view_mailing_contacts" title="Add Mailing Contacts" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, &quot;|&quot;, [&quot;contact_list_ids&quot;, &quot;=&quot;, false], [&quot;contact_list_ids&quot;, &quot;=&quot;, []], [&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]]}"/>
                                        </div>
                                    </div>
                                    <div class="o_td_label" modifiers="{&quot;invisible&quot;: [[&quot;mailing_model_name&quot;, &quot;=&quot;, &quot;mailing.list&quot;]]}">
                                        <!-- We don't want to display label in edit mode, unless mailing is in sending or done state (where filter will be readonly) -->
                                        <label for="mailing_filter_id" string="Filter" class="oe_read_only me-4" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]], [&quot;mailing_filter_id&quot;, &quot;=&quot;, false]]}"/>
                                        <label for="mailing_filter_id" string="Filter" class="me-4" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;state&quot;, &quot;not in&quot;, [&quot;sending&quot;, &quot;done&quot;]], [&quot;mailing_filter_id&quot;, &quot;=&quot;, false]]}"/>
                                        <field name="mailing_filter_id" placeholder="Reload a favorite filter" class="w-auto" widget="mailing_filter" options="{'no_create': 1, 'no_open': 1, 'domain_field': 'mailing_domain', 'model_field': 'mailing_model_id'}" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]]}" can_create="true" can_write="true"/>
                                    </div>
                                    <field name="mailing_filter_count" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                                    <field name="mailing_filter_domain" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                                </div>

                                <field name="mailing_model_name" on_change="1" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                                <field name="mailing_model_real" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                                <div class="w-lg-50" modifiers="{&quot;invisible&quot;: [[&quot;mailing_model_name&quot;, &quot;=&quot;, &quot;mailing.list&quot;]]}">
                                    <field name="mailing_domain" widget="domain" options="{'model': 'mailing_model_real'}" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]]}"/>
                                </div>
                            </div>
                        </group>
                        <notebook>
                            <page string="Mail Body" name="mail_body">
                                <div class="position-relative">
                                    <div class="mt-n2">
                                        <field name="body_arch" class="o_mail_body" widget="mass_mailing_html" iframeHtmlClass="o_mass_mailing_iframe" options="{                                                 'snippets': 'mass_mailing.email_designer_snippets',                                                 'cssEdit': 'mass_mailing.iframe_css_assets_edit',                                                 'inline-field': 'body_html',                                                 'dynamic_placeholder': true,                                                 'cssReadonly': 'mass_mailing.iframe_css_assets_edit'                                         }" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]]}"/>
                                    </div>
                                    <field name="is_body_empty" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                                    <div class="o_view_nocontent oe_read_only" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;is_body_empty&quot;, &quot;=&quot;, false], [&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]]}">
                                        <div class="o_nocontent_help">
                                            <p class="o_view_nocontent_smiling_face">
                                                This mailing has no selected design (yet!).
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </page>
                            <page string="A/B Tests" name="ab_testing">
                                <group>
                                    <group>
                                        <label for="ab_testing_enabled"/>
                                        <span class="d-flex">
                                            <field name="ab_testing_enabled" force_save="1" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;]]}"/>
                                            <span class="d-flex" modifiers="{&quot;invisible&quot;: [[&quot;ab_testing_enabled&quot;, &quot;=&quot;, false]]}">
                                                on <field name="ab_testing_pc" class="mx-1 text-center" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;]]}"/> %
                                            </span>
                                        </span>
                                        <field name="ab_testing_winner_selection" on_change="1" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;ab_testing_enabled&quot;, &quot;=&quot;, false], [&quot;mailing_type&quot;, &quot;!=&quot;, &quot;mail&quot;]], &quot;readonly&quot;: [[&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;]], &quot;required&quot;: [[&quot;ab_testing_enabled&quot;, &quot;=&quot;, true], [&quot;mailing_type&quot;, &quot;=&quot;, &quot;mail&quot;]]}"/>
                                        <field name="ab_testing_schedule_datetime" on_change="1" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;ab_testing_enabled&quot;, &quot;=&quot;, false], [&quot;ab_testing_winner_selection&quot;, &quot;=&quot;, &quot;manual&quot;]], &quot;readonly&quot;: [&quot;|&quot;, [&quot;ab_testing_enabled&quot;, &quot;=&quot;, false], [&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;]], &quot;required&quot;: [[&quot;ab_testing_enabled&quot;, &quot;=&quot;, true], [&quot;ab_testing_winner_selection&quot;, &quot;!=&quot;, &quot;manual&quot;]]}"/>
                                    </group>
                                    <div>
                                        <field name="ab_testing_mailings_count" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                                        <field name="ab_testing_completed" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                                        <field name="ab_testing_description" nolabel="1" modifiers="{&quot;readonly&quot;: true}"/>
                                        <div modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;ab_testing_mailings_count&quot;, &quot;&lt;&quot;, 2], [&quot;ab_testing_enabled&quot;, &quot;=&quot;, false]]}">
                                            <button name="action_compare_versions" type="object" class="btn btn-link d-block">
                                                <i class="fa fa-bar-chart"/> Compare Version
                                            </button>
                                            <button name="action_duplicate" type="object" class="btn btn-link d-block" modifiers="{&quot;invisible&quot;: [[&quot;ab_testing_completed&quot;, &quot;=&quot;, true]]}">
                                                <i class="fa fa-copy"/> Create an Alternative
                                            </button>
                                            <button name="action_send_winner_mailing" type="object" class="btn btn-link d-block" modifiers="{&quot;invisible&quot;: [[&quot;ab_testing_completed&quot;, &quot;=&quot;, true]]}">
                                                <i class="fa fa-envelope"/> <span name="ab_test_manual" modifiers="{&quot;invisible&quot;: [[&quot;ab_testing_winner_selection&quot;, &quot;!=&quot;, &quot;manual&quot;]]}">
                                                    Send this version to remaining recipients
                                                </span> <span name="ab_test_auto" modifiers="{&quot;invisible&quot;: [[&quot;ab_testing_winner_selection&quot;, &quot;=&quot;, &quot;manual&quot;]]}">
                                                    Send Winner Now
                                                </span>
                                            </button>
                                            <button name="action_select_as_winner" type="object" class="btn btn-link d-block" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;ab_testing_completed&quot;, &quot;!=&quot;, false], [&quot;ab_testing_winner_selection&quot;, &quot;!=&quot;, &quot;manual&quot;]]}">
                                                <i class="fa fa-envelope"/> Send this as winner
                                            </button>
                                        </div>
                                        <button name="action_duplicate" type="object" class="btn btn-primary" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;ab_testing_mailings_count&quot;, &quot;&gt;=&quot;, 2], [&quot;ab_testing_enabled&quot;, &quot;=&quot;, false]]}">
                                            Create an Alternative Version
                                        </button>
                                    </div>
                                </group>
                            </page>
                            <page string="Settings" name="settings">
                                <group>
                                    <group string="Email Content" name="email_content" modifiers="{&quot;invisible&quot;: [[&quot;mailing_type&quot;, &quot;!=&quot;, &quot;mail&quot;]]}">
                                        <field class="o_text_overflow" name="preview" string="Preview Text" options="{'dynamic_placeholder': true}" widget="char_emojis" placeholder="e.g. Check it out before it's too late!" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]]}"/>
                                        <field name="email_from" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]], &quot;required&quot;: true}"/>
                                        <label for="reply_to"/>
                                        <div name="reply_to_details">
                                            <field name="reply_to_mode" widget="radio" on_change="1" modifiers="{&quot;invisible&quot;: [[&quot;mailing_model_name&quot;, &quot;in&quot;, [&quot;mailing.contact&quot;, &quot;res.partner&quot;, &quot;mailing.list&quot;]]], &quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]]}"/>
                                            <field name="reply_to" modifiers="{&quot;invisible&quot;: [[&quot;reply_to_mode&quot;, &quot;=&quot;, &quot;update&quot;]], &quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]], &quot;required&quot;: [[&quot;reply_to_mode&quot;, &quot;=&quot;, &quot;new&quot;]]}"/>
                                            <div style="margin-top:-5px">
                                                <small class="oe_edit_only text-muted mb-2" style="font-size:74%" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;reply_to_mode&quot;, &quot;=&quot;, &quot;update&quot;], [&quot;mailing_model_name&quot;, &quot;in&quot;, [&quot;mailing.contact&quot;, &quot;res.partner&quot;, &quot;mailing.list&quot;]]]}">
                                                    To track replies, this address must belong to this database.
                                                </small>
                                            </div>
                                        </div>
                                        <label for="attachment_ids"/>
                                        <div name="attachment_ids_details">
                                            <field name="attachment_ids" widget="many2many_binary" string="Attach a file" class="oe_inline" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]]}" can_create="true" can_write="true"/>
                                        </div>
                                    </group>
                                    <group string="Tracking">
                                        <field name="campaign_id" string="Campaign" options="{'create_name_field': 'title', 'always_reload': True}" on_change="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;sending&quot;, &quot;done&quot;]]]}" can_create="true" can_write="true"/>
                                        <field name="user_id" widget="many2one_avatar_user" domain="[('share', '=', False)]" can_create="true" can_write="true"/>
                                    </group>
                                    </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                        <field name="activity_ids"/>
                    </div>
                </form>
        </field>
    </record>

    <record id="view_mailing_mailing_search" model="ir.ui.view">
        <field name="name">mailing.mailing.search</field>
        <field name="model">mailing.mailing</field>
        <field name="arch" type="xml">
            <search string="Mailings">
                    <field name="name" string="Mailing" filter_domain="['|', ('name', 'ilike', self), ('subject', 'ilike', self)]"/>
                    <field name="campaign_id" string="Campaign"/>
                    <filter string="My Mailings" name="assigned_to_me" domain="[('user_id', '=', uid)]" help="Mailings that are assigned to me"/>
                    <separator/>
                    <filter name="filter_sent_date" date="sent_date"/>
                    <separator/>
                    <filter string="A/B Tests" name="filter_ab_test" domain="[('ab_testing_enabled', '=', True)]"/>
                    <filter string="A/B Tests to review" name="filter_ab_test_to_review" domain="[('ab_testing_enabled', '=', True), ('ab_testing_winner_selection', '=', 'manual'), ('ab_testing_completed', '=', False)]"/>
                    <separator/>
                    <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Sent By" name="sent_by" domain="[]" context="{'group_by': 'email_from'}"/>
                        <separator/>
                        <filter string="Sent Period" name="sent_date" domain="[]" context="{'group_by': 'sent_date'}"/>
                    </group>
                </search>
        </field>
    </record>

    <record id="action_mailing_mailing" model="ir.actions.act_window">
        <field name="name">MAILING MAILING</field>
        <field name="res_model">mailing.mailing</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
