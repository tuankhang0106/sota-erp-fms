<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utm_stage_tree" model="ir.ui.view">
        <field name="name">utm.stage.tree</field>
        <field name="model">utm.stage</field>
        <field name="arch" type="xml">
            <tree string="Stages" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name" modifiers="{&quot;required&quot;: true}"/>
            </tree>
        </field>
    </record>

    <record id="view_utm_stage_form" model="ir.ui.view">
        <field name="name">utm.stage.form</field>
        <field name="model">utm.stage</field>
        <field name="arch" type="xml">
            <form><sheet string="Campaign Stage"><group><group><field name="name" modifiers="{&quot;required&quot;: true}"/></group><group><field name="sequence"/></group></group><group><separator/></group></sheet></form>
        </field>
    </record>

    <record id="view_utm_stage_search" model="ir.ui.view">
        <field name="name">utm.stage.search</field>
        <field name="model">utm.stage</field>
        <field name="arch" type="xml">
            <search string="Stages">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_utm_stage" model="ir.actions.act_window">
        <field name="name">UTM STAGE</field>
        <field name="res_model">utm.stage</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
