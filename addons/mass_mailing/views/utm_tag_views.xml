<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utm_tag_tree" model="ir.ui.view">
        <field name="name">utm.tag.tree</field>
        <field name="model">utm.tag</field>
        <field name="arch" type="xml">
            <tree string="Campaign Tags" editable="top">
                <field name="name" modifiers="{&quot;required&quot;: true}"/>
            </tree>
        </field>
    </record>

    <record id="view_utm_tag_form" model="ir.ui.view">
        <field name="name">utm.tag.form</field>
        <field name="model">utm.tag</field>
        <field name="arch" type="xml">
            <form><sheet string="UTM Tag"><group><group><field name="name" modifiers="{&quot;required&quot;: true}"/></group><group><field name="color"/></group></group><group><separator/></group></sheet></form>
        </field>
    </record>

    <record id="view_utm_tag_search" model="ir.ui.view">
        <field name="name">utm.tag.search</field>
        <field name="model">utm.tag</field>
        <field name="arch" type="xml">
            <search string="UTM Tag"><field name="name"/></search>
        </field>
    </record>

    <record id="action_utm_tag" model="ir.actions.act_window">
        <field name="name">UTM TAG</field>
        <field name="res_model">utm.tag</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
