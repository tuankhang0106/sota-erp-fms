<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ks_dashboard_ninja_child_board_tree" model="ir.ui.view">
        <field name="name">ks_dashboard_ninja.child_board.tree</field>
        <field name="model">ks_dashboard_ninja.child_board</field>
        <field name="arch" type="xml">
            <tree string="Dashboard Layout" editable="top" create="0">
                    <field name="name"/>
                    <field name="ks_dashboard_ninja_id" string="Dashboard" can_create="true" can_write="true"/>
                    <field name="company_id" string="Company" modifiers="{&quot;required&quot;: true}" can_create="true" can_write="true"/>
                </tree>
        </field>
    </record>

    <record id="view_ks_dashboard_ninja_child_board_form" model="ir.ui.view">
        <field name="name">ks_dashboard_ninja.child_board.form</field>
        <field name="model">ks_dashboard_ninja.child_board</field>
        <field name="arch" type="xml">
            <form><sheet string="Dashboard Ninja Child Board"><group><group><field name="name"/><field name="ks_gridstack_config"/><field name="ks_dashboard_menu_name" modifiers="{&quot;readonly&quot;: true}"/><field name="company_id" modifiers="{&quot;required&quot;: true}" can_create="true" can_write="true"/></group><group><field name="ks_dashboard_ninja_id" on_change="1" can_create="true" can_write="true"/><field name="ks_active"/><field name="board_type"/></group></group><group><separator/></group></sheet></form>
        </field>
    </record>

    <record id="view_ks_dashboard_ninja_child_board_search" model="ir.ui.view">
        <field name="name">ks_dashboard_ninja.child_board.search</field>
        <field name="model">ks_dashboard_ninja.child_board</field>
        <field name="arch" type="xml">
            <search string="Dashboard Ninja Child Board"><field name="name"/></search>
        </field>
    </record>

    <record id="action_ks_dashboard_ninja_child_board" model="ir.actions.act_window">
        <field name="name">KS_DASHBOARD_NINJA CHILD_BOARD</field>
        <field name="res_model">ks_dashboard_ninja.child_board</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
