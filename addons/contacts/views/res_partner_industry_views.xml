<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_industry_tree" model="ir.ui.view">
        <field name="name">res.partner.industry.tree</field>
        <field name="model">res.partner.industry</field>
        <field name="arch" type="xml">
            <tree string="Industry" editable="bottom">
                    <field name="name"/>
                    <field name="full_name"/>
                    <field name="active" modifiers="{&quot;column_invisible&quot;: true}"/>
                </tree>
        </field>
    </record>

    <record id="view_res_partner_industry_form" model="ir.ui.view">
        <field name="name">res.partner.industry.form</field>
        <field name="model">res.partner.industry</field>
        <field name="arch" type="xml">
            <form string="Industry">
                    <sheet>
                        <group col="4">
                            <field name="name"/>
                            <field name="full_name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
        </field>
    </record>

    <record id="view_res_partner_industry_search" model="ir.ui.view">
        <field name="name">res.partner.industry.search</field>
        <field name="model">res.partner.industry</field>
        <field name="arch" type="xml">
            <search string="Search Partner Industry">
                    <field name="name"/>
                    <field name="full_name"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
        </field>
    </record>

    <record id="action_res_partner_industry" model="ir.actions.act_window">
        <field name="name">RES PARTNER INDUSTRY</field>
        <field name="res_model">res.partner.industry</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
