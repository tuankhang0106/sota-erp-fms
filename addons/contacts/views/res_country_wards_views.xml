<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_country_wards_tree" model="ir.ui.view">
        <field name="name">res.country.wards.tree</field>
        <field name="model">res.country.wards</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="state_id" can_create="true" can_write="true"/>
                <field name="name_extension"/>
            </tree>
        </field>
    </record>

    <record id="view_res_country_wards_form" model="ir.ui.view">
        <field name="name">res.country.wards.form</field>
        <field name="model">res.country.wards</field>
        <field name="arch" type="xml">
            <form><sheet string="Wards"><group><group><field name="code"/><field name="state_id" can_create="true" can_write="true"/><field name="name_extension"/></group><group><field name="name"/><field name="active"/><field name="is_vietnam_new_wards"/></group></group><group><separator/></group></sheet></form>
        </field>
    </record>

    <record id="view_res_country_wards_search" model="ir.ui.view">
        <field name="name">res.country.wards.search</field>
        <field name="model">res.country.wards</field>
        <field name="arch" type="xml">
            <search string="Wards"><field name="name"/></search>
        </field>
    </record>

    <record id="action_res_country_wards" model="ir.actions.act_window">
        <field name="name">RES COUNTRY WARDS</field>
        <field name="res_model">res.country.wards</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
