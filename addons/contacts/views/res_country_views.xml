<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_country_tree" model="ir.ui.view">
        <field name="name">res.country.tree</field>
        <field name="model">res.country</field>
        <field name="arch" type="xml">
            <tree string="Country" create="0" delete="0">
                    <field name="name" modifiers="{&quot;required&quot;: true}"/>
                    <field name="code"/>
                </tree>
        </field>
    </record>

    <record id="view_res_country_form" model="ir.ui.view">
        <field name="name">res.country.form</field>
        <field name="model">res.country</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <field name="image_url" widget="image_url" class="oe_avatar" options="{'size': [128,128]}" modifiers="{&quot;readonly&quot;: true}"/>
                        <group name="main_group">
                            <group name="country_details">
                                <field name="name" modifiers="{&quot;required&quot;: true}"/>
                                <field name="currency_id" can_create="true" can_write="true"/>
                                <field name="code" on_change="1" modifiers="{&quot;required&quot;: true}"/>
                            </group>
                            <group name="phone_vat_settings">
                                <field name="phone_code" options="{'format': false}"/>
                                <field name="vat_label"/>
                                <field name="zip_required"/>
                                <field name="state_required"/>
                            </group>
                        </group>
                        <label for="state_ids"/>
                        <field name="state_ids">
                            <tree editable="bottom">
                                <field name="name" modifiers="{&quot;required&quot;: true}"/>
                                <field name="code" modifiers="{&quot;required&quot;: true}"/>
                            </tree>
                        </field>
                    </sheet>
                </form>
        </field>
    </record>

    <record id="view_res_country_search" model="ir.ui.view">
        <field name="name">res.country.search</field>
        <field name="model">res.country</field>
        <field name="arch" type="xml">
            <search string="Country Search">
<field name="name"/>
<field name="code"/>
<separator name="separator"/> <!-- for extending filters -->
<group expand="0" string="Group By">
<filter name="grp_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
</group>
</search>
        </field>
    </record>

    <record id="action_res_country" model="ir.actions.act_window">
        <field name="name">RES COUNTRY</field>
        <field name="res_model">res.country</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
