                <field name="class_urgent"/>
                <field name="pol_id"/>
                <field name="pod_id"/>
                <field name="door_address"/>
                <field name="incoterms_id"/>
                <field name="type_of_cont"/>
                <field name="transport_term_of_oog_bulk"/>
                <field name="commodity_id"/>
                <field name="msds_dg_form"/>
                <field name="etd_request_cargo_ready"/>
