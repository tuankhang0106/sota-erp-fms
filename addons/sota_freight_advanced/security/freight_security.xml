<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_freight_category" model="ir.module.category">
        <field name="name">Vận chuyển (Freight FMS)</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_freight_user" model="res.groups">
        <field name="name">Người dùng Vận chuyển (User)</field>
        <field name="category_id" ref="module_freight_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_freight_manager" model="res.groups">
        <field name="name">Quản trị viên Vận chuyển (Manager)</field>
        <field name="category_id" ref="module_freight_category"/>
        <field name="implied_ids" eval="[(4, ref('group_freight_user'))]"/>
    </record>
</odoo>
