<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu 1: Activity Dashboard (ID: 164, Action: 257) -->
    <menuitem id="sh_activity_dashboard_root"
              name="Activity Dashboard"
              web_icon="sh_activities_management,static/description/icon.png"
              sequence="3"/>

    <!-- Action Client Dashboard (Action 257) -->
    <record id="action_activity_dashboard_client" model="ir.actions.client">
        <field name="name">Activity Dashboard</field>
        <field name="tag">activity_dashboard.dashboard</field>
    </record>

    <!-- Sub-menu: Dashboard (ID: 175) -->
    <menuitem id="sh_menu_activity_dashboard"
              name="Dashboard"
              parent="sh_activity_dashboard_root"
              action="action_activity_dashboard_client"
              sequence="1"/>

    <!-- Sub-menu Group: Activity (ID: 169) -->
    <menuitem id="sh_activity_menu_parent"
              name="Activity"
              parent="sh_activity_dashboard_root"
              sequence="10"/>

    <menuitem id="all_activity_menu"
              name="All Activities"
              parent="sh_activity_menu_parent"
              action="action_all_activities"
              sequence="1"/>

    <menuitem id="sh_supervisor_activity_menu"
              name="Supervisor Activities"
              parent="sh_activity_menu_parent"
              action="action_supervisor_activities"
              sequence="2"/>

    <menuitem id="sh_my_activity_menu"
              name="My Activities"
              parent="sh_activity_menu_parent"
              action="action_my_activities"
              sequence="3"/>

    <!-- Sub-menu Group: Reporting (ID: 174, Action: 252) -->
    <menuitem id="reporting_menu"
              name="Reporting"
              parent="sh_activity_dashboard_root"
              action="action_activity_reporting"
              sequence="20"/>

    <!-- Sub-menu Group: Configuration (ID: 165) -->
    <menuitem id="menu_config"
              name="Configuration"
              parent="sh_activity_dashboard_root"
              sequence="100"
              groups="base.group_system"/>

    <menuitem id="sh_activity_tags_menu"
              name="Activity Tags"
              parent="menu_config"
              action="action_sh_activity_tags"
              sequence="10"/>

    <menuitem id="sh_activity_alarm_menu"
              name="Activity Alarm"
              parent="menu_config"
              action="action_sh_activity_alarm"
              sequence="20"/>

    <menuitem id="menu_config_activity"
              name="Settings"
              parent="menu_config"
              action="action_activity_config_settings"
              sequence="30"/>

    <!-- Root Menu 2: Mass Activities Dynamic Action (ID: 168, Action: 250) -->
    <menuitem id="sh_activity_management_dynamic_action_action_menu"
              name="Mass Activities Dynamic Action"
              action="action_sh_activity_dynamic_action"
              web_icon="sh_activities_management,static/description/dynamic_icon.png"
              sequence="6"/>
</odoo>
